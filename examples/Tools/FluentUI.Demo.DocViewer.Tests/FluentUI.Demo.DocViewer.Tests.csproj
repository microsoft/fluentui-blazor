<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(ExampleNetVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentUI.Demo.DocViewer\FluentUI.Demo.DocViewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.md" />
    <EmbeddedResource Include="..\..\Demo\FluentUI.Demo.Client\Documentation\GetStarted\Migration\MigrationFluentButton.md" Link="Resources\MigrationFluentButton.md" />
    <EmbeddedResource Include="..\..\Demo\FluentUI.Demo.Client\Documentation\GetStarted\Migration\MigrationFluentAutocomplete.md" Link="Resources\MigrationFluentAutocomplete.md" />
  </ItemGroup>

</Project>
