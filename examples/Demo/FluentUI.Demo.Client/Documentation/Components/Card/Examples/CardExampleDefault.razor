<FluentCard Padding="0" Style="max-width: 800px;">
    <FluentStack Orientation="Orientation.Vertical">

        <FluentStack HorizontalGap="8px"
                     Margin="@Margin.All2"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentAvatar Name="Elvia Atkins"
                          Size="AvatarSize.Size32"
                          Image="@AvatarBase64" />
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="0px">
                <FluentText>
                    <span style="font-weight: bold;">Elvia Atkins</span>
                    mentioned you
                </FluentText>
                <FluentText Size="TextSize.Size200"
                            Color="@Color.Custom"
                            CustomColor="@SystemColors.Neutral.Foreground3">
                    5h ago - About us - Overview
                </FluentText>
            </FluentStack>
        </FluentStack>

        <FluentImage Source="@CardImageBase64"
                     Block="true"
                     AlternateText="About us" />

        <FluentStack HorizontalGap="8px"
                     Margin="@Margin.All2">
            <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowReply())"
                          OnClick="@(e => Console.WriteLine("Reply clicked"))">
                Reply
            </FluentButton>
            <FluentButton IconStart="@(new Icons.Regular.Size20.Share())"
                          OnClick="@(e => Console.WriteLine("Share clicked"))">
                Share
            </FluentButton>
        </FluentStack>

    </FluentStack>
</FluentCard>

@code
{
    /* 
        Use a Logo URL or a Base64 string for the image source.
        The base64 string is used here to avoid external dependencies.
    */    

    const string AvatarUrl = "https://fabricweb.azureedge.net/fabric-website/assets/images/avatar/KatriAthokas.jpg";
    const string AvatarBase64 = "data:image/png;base64,";
    
    const string CardImageUrl = "https://raw.githubusercontent.com/microsoft/fluentui/master/packages/react-components/react-card/stories/src/assets/doc_template.png";
    const string CardImageBase64 = "data:image/jpeg;base64,";
}