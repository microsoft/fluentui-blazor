<FluentStack HorizontalGap="12px" Wrap="true">

    <b>Card with click event</b>
    <FluentCard Width="300px" OnClick="@(e => Open())">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            <FluentStack HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Icons.Filled.Size24.AppGeneric())" Color="Color.Primary" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0px">
                    <FluentText Weight="TextWeight.Semibold">App Name</FluentText>
                    <FluentText Size="TextSize.Size200" Color="@Color.Custom" CustomColor="@SystemColors.Neutral.Foreground3">
                        Developer
                    </FluentText>
                </FluentStack>
            </FluentStack>

            <FluentText>
                Donut chocolate bar oat cake. Dragée tiramisu lollipop bear claw. Marshmallow pastry jujubes toffee sugar plum.
            </FluentText>

            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size20.Open())"
                          OnClick="@(e => Open())">
                Open
            </FluentButton>
        </FluentStack>
    </FluentCard>

    <br />

    <b>Linked card</b>
    <FluentCard Width="300px">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            <FluentStack HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Icons.Filled.Size24.AppGeneric())" Color="Color.Primary" />
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0px">
                    <FluentLink Href="https://www.microsoft.com" Target="LinkTarget.Blank">
                        App Name
                    </FluentLink>
                    <FluentText Size="TextSize.Size200" Color="@Color.Custom" CustomColor="@SystemColors.Neutral.Foreground3">
                        Developer
                    </FluentText>
                </FluentStack>
            </FluentStack>
        </FluentStack>
    </FluentCard>

</FluentStack>

@code
{
    private void Open()
    {
        Console.WriteLine("Open clicked");
    }
}
