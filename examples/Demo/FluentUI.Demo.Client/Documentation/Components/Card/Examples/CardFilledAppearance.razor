<FluentCard Appearance="CardAppearance.Filled" Width="300px">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">

        <FluentStack HorizontalGap="8px" VerticalAlignment="VerticalAlignment.Center">
            <div style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 4px; background: var(--colorBrandBackground2);">
                <FluentIcon Value="@(new Icons.Filled.Size24.AppGeneric())" Color="Color.Primary" />
            </div>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0px">
                <FluentText Weight="TextWeight.Semibold">App Name</FluentText>
                <FluentText Size="TextSize.Size200" Color="@Color.Custom" CustomColor="@SystemColors.Neutral.Foreground3">
                    Developer
                </FluentText>
            </FluentStack>
        </FluentStack>

        <FluentText>
            Donut chocolate bar oat cake. Dragée tiramisu lollipop bear claw. Marshmallow pastry jujubes toffee sugar plum.
        </FluentText>

    </FluentStack>
</FluentCard>
