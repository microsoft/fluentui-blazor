<FluentStack HorizontalGap="12px"
             VerticalGap="12px"
             Wrap="true">

    @foreach (var item in Items)
    {
        <FluentCard Width="300px"
                    Appearance="@(item.Selected ? CardAppearance.Filled : CardAppearance.Outline)"
                    OnClick="@(() => Toggle(item))"
                    Style="@("position: relative;" + (item.Selected ? CardStyleSelected : null))">
            
            <FluentCheckbox Value="@item.Selected"
                            ReadOnly="true"
                            Style="position: absolute; top: 8px; right: 8px; pointer-events: none;" />

            <FluentStack VerticalAlignment="VerticalAlignment.Center">
                <FluentImage Source="@item.ImageSource" 
                             Width="32px" />
                <FluentStack Orientation="Orientation.Vertical"
                             Margin="@Margin.Horizontal2">
                    <FluentText Weight="TextWeight.Semibold">
                        @item.Title
                    </FluentText>
                    <FluentText Size="TextSize.Size200"
                                Color="@Color.Custom"
                                CustomColor="@SystemColors.Neutral.Foreground3">
                        @item.Subtitle
                    </FluentText>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }

</FluentStack>

@code
{
    // Use a Logo URL or a Base64 string for the image source.
    // The base64 string is used here to avoid external dependencies.
    // const string PowerPointLogoUrl = "https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/powerpoint_48x1.svg";
    // const string WordLogoUrl = "https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/word_48x1.svg";
    const string PowerPointLogo = "data:image/png;base64,";
    const string WordLogo = "data:image/png;base64,";

    // Style for selected card
    // const string CardStyleSelected = ""; 
    const string CardStyleSelected = "outline: var(--strokeWidthThick) solid var(--colorBrandStroke1);";

    readonly List<CardItem> Items =
    [
        new() { Title = "Secret Project Briefing", Subtitle = "OneDrive > Documents", ImageSource = WordLogo },
        new() { Title = "Team Budget", Subtitle = "OneDrive > Presentations", ImageSource = PowerPointLogo },
    ];

    void Toggle(CardItem item)
    {
        item.Selected = !item.Selected;
    }

    class CardItem
    {
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
        public string ImageSource { get; set; } = PowerPointLogo;
        public bool Selected { get; set; }
    }
}
