@inject NavigationManager NavigationManager

<!-- Card with click event -->
<FluentCard Padding="0" 
            Role="link"
            OnClick="@(_ => Open())"
            Style="max-width: 500px;">
    <FluentStack Orientation="Orientation.Vertical">

        <FluentImage Source="@CardImageBase64"
                     Block="true"
                     AlternateText="About us" />

        <FluentStack HorizontalGap="8px"
                     Margin="@Margin.All2"
                     Width="unset"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentAvatar Name="Elvia Atkins"
                          Size="AvatarSize.Size32"
                          Image="@PowerPointLogo" />
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="0px">
                <FluentText Weight="TextWeight.Semibold">
                    App Name
                </FluentText>
                <FluentText Size="TextSize.Size200"
                            Color="@Color.Custom"
                            CustomColor="@SystemColors.Neutral.Foreground3">
                    Developer
                </FluentText>
            </FluentStack>
        </FluentStack>

    </FluentStack>
</FluentCard>

@code
{
     /* 
        Use a Logo URL or a Base64 string for the image source.
        The base64 string is used here to avoid external dependencies.
    */    
    
    const string CardImageUrl = "https://raw.githubusercontent.com/microsoft/fluentui/master/packages/react-components/react-card/stories/src/assets/office2.png";
    const string CardImageBase64 = "data:image/png;base64,";

    const string PowerPointLogoUrl = "https://static2.sharepointonline.com/files/fabric/assets/brand-icons/product/svg/powerpoint_48x1.svg";
    const string PowerPointLogo = "data:image/png;base64,";

    void Open()
    {
        NavigationManager.NavigateTo("https://www.microsoft.com/");
    }
}
