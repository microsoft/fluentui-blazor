@page "/textinput-immediate"

<FluentStack Orientation="Orientation.Vertical">
    <FluentTextInput Appearance="@TextInputAppearance.Outline"
                     Placeholder="Updated after 400ms"
                     @bind-Value="@Value"
                     Immediate="true"
                     ImmediateDelay="10" />

    <FluentLabel>Value = @Value</FluentLabel>
</FluentStack>


@code
{
    string Value = "";
}
