                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers", Data = 87, Color = DataVizPalette.Color10 },
                new HorizontalBarChartDataPoint { Legend = "Tax identification numbers (USA)", Data = 87, Color = DataVizPalette.Custom, CustomColor = "#004E8C" }
