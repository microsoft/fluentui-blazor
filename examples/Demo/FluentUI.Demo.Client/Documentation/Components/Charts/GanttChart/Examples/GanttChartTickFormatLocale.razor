@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentGanttChart ChartTitle="Gantt Chart — date tick format (%m/%d)"
                  ChartData="@_chartData"
                  TickFormat="%m/%d">
</FluentGanttChart>

@code {
    private readonly IReadOnlyList<GanttChartDataPoint> _chartData =
    [
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2026, 1, 1), End = new DateTime(2026, 2, 28) },
            Y = "Job A",
            Legend = "Alex",
            Color = DataVizPalette.Color1,
        },
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2026, 3, 5), End = new DateTime(2026, 4, 15) },
            Y = "Job B",
            Legend = "Alex",
            Color = DataVizPalette.Color1,
        },
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2026, 2, 20), End = new DateTime(2026, 5, 30) },
            Y = "Job C",
            Legend = "Max",
            Color = DataVizPalette.Color2,
        },
    ];
}
