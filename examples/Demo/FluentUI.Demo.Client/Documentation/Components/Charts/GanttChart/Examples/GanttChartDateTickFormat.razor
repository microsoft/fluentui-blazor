@using Microsoft.FluentUI.AspNetCore.Components.Charts

@*
    TickFormat accepts a d3-time-format specifier (e.g. "%m/%d") for date x-axis tick labels.
    This attribute is reserved for future d3-time-format support and currently has no visual effect.
    Use DateLocalizeOptions together with Culture to customise date formatting today.
*@

<FluentGanttChart Style="width: 600px; height: 350px"
                  ChartTitle="TickFormat placeholder (no visual effect — reserved for d3-time-format)" ShowYAxisLabels="true"
                  TickFormat="%m/%d" ChartData="@ChartData">
</FluentGanttChart>

@code {
  private IReadOnlyList<GanttChartDataPoint> ChartData =
  [
      new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 1, 1), End = new DateTime(2009, 2, 28)
}, Y = "Job A", Legend = "Alex", Color = DataVizPalette.Color1 },
        new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 3, 5), End = new DateTime(2009, 4, 15)
}, Y = "Job B", Legend = "Alex", Color = DataVizPalette.Color1 },
        new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 2, 20), End = new DateTime(2009, 5, 30)
}, Y = "Job C", Legend = "Max", Color = DataVizPalette.Color2 },
    ];
}
