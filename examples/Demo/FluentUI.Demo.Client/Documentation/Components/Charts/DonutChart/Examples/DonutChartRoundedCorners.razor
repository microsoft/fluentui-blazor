@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentCheckbox @bind-Value="@_roundedCorners" Label="Rounded corners" />

<FluentDonutChart ChartData="@data"
                  ChartTitle="Donut chart rounded corners example"
                  InnerRadius="55"
                  ValueInsideDonut="39,000"
                  RoundedCorners="@_roundedCorners" />

@code {
    private bool _roundedCorners = true;

    private readonly IReadOnlyList<DonutDataPoint> data = new List<DonutDataPoint>
    {
        new DonutDataPoint { Legend = "first", Data = 15000 },
        new DonutDataPoint { Legend = "second", Data = 25000 },
        new DonutDataPoint { Legend = "third", Data = 35000 },
    };
}
