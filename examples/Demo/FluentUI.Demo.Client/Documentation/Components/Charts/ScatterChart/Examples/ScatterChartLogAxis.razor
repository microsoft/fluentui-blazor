@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="margin-top: 16px;">
    <div style="max-width: 220px;">
        <FluentSelect TOption="string"
                      TValue="string"
                      Label="xScaleType"
                      Value="@_xScaleType.ToString()"
                      ValueChanged="@(v => _xScaleType = Enum.Parse<ChartAxisScaleType>(v))">
            @foreach (var opt in _scaleOptions)
            {
                <FluentOptionString Value="@opt.ToString()">@opt.ToString()</FluentOptionString>
            }
        </FluentSelect>
    </div>
    <div style="max-width: 220px;">
        <FluentSelect TOption="string"
                      TValue="string"
                      Label="yScaleType"
                      Value="@_yScaleType.ToString()"
                      ValueChanged="@(v => _yScaleType = Enum.Parse<ChartAxisScaleType>(v))">
            @foreach (var opt in _scaleOptions)
            {
                <FluentOptionString Value="@opt.ToString()">@opt.ToString()</FluentOptionString>
            }
        </FluentSelect>
    </div>
</FluentStack>

<FluentScatterChart ChartTitle="Scatter Chart"
                    ChartData="@_chartData"
                    Width="700px"
                    XAxisScaleType="@_xScaleType"
                    YAxisScaleType="@_yScaleType"
                    HideTickOverlap="true">
</FluentScatterChart>

