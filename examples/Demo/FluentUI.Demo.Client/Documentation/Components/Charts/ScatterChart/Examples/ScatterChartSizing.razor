@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="scatter-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="scatter-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentScatterChart ChartTitle="Scatter chart sizing example"
                    ChartData="@data"
                    Width="@($"{_width}px")"
                    Height="@($"{_height}px")" />

@code {
    private int _width = 650;
    private int _height = 400;

    private readonly IReadOnlyList<ScatterChartSeries> data =
    [
        new ScatterChartSeries
        {
            Legend = "Phase 1",
            Color = DataVizPalette.Custom,
            CustomColor = "qualitative.3",
            Data =
            [
                new ScatterChartDataPoint { X = 10.0, Y = 50000, MarkerSize = 12 },
                new ScatterChartDataPoint { X = 20.0, Y = 75000, MarkerSize = 15 },
                new ScatterChartDataPoint { X = 30.0, Y = 90000, MarkerSize = 18 },
            ],
        },
        new ScatterChartSeries
        {
            Legend = "Phase 2",
            Color = DataVizPalette.Custom,
            CustomColor = "qualitative.4",
            Data =
            [
                new ScatterChartDataPoint { X = 60.0, Y = 180000, MarkerSize = 28 },
                new ScatterChartDataPoint { X = 70.0, Y = 200000, MarkerSize = 30 },
            ],
        },
    ];
}
