@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentSankeyChart ChartTitle="Sankey Chart basic example"
                   ChartData="@chartData"
                   Width="820px"
                   Height="412px">
</FluentSankeyChart>

@code {
    private readonly SankeyChartData chartData = new()
    {
        Nodes =
        [
            new SankeyChartNode { Name = "node0", Color = DataVizPalette.Custom, CustomColor = "qualitative.2" },
            new SankeyChartNode { Name = "node1", Color = DataVizPalette.Custom, CustomColor = "qualitative.7" },
            new SankeyChartNode { Name = "node2", Color = DataVizPalette.Custom, CustomColor = "qualitative.8" },
            new SankeyChartNode { Name = "node3", Color = DataVizPalette.Custom, CustomColor = "qualitative.9" },
            new SankeyChartNode { Name = "node4", Color = DataVizPalette.Custom, CustomColor = "qualitative.11" },
            new SankeyChartNode { Name = "node5", Color = DataVizPalette.Custom, CustomColor = "qualitative.12" },
        ],
        Links =
        [
            new SankeyChartLink { Source = 0, Target = 2, Value = 2 },
            new SankeyChartLink { Source = 1, Target = 2, Value = 2 },
            new SankeyChartLink { Source = 1, Target = 3, Value = 2 },
            new SankeyChartLink { Source = 0, Target = 4, Value = 2 },
            new SankeyChartLink { Source = 2, Target = 3, Value = 2 },
            new SankeyChartLink { Source = 2, Target = 4, Value = 2 },
            new SankeyChartLink { Source = 3, Target = 4, Value = 4 },
            new SankeyChartLink { Source = 3, Target = 5, Value = 4 },
        ],
    };
}
