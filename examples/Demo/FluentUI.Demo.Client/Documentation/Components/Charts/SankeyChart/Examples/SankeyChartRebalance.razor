@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Style="margin-bottom: 16px;">
    <FluentSwitch @bind-Value="@_useSimpleData" @bind-Value:after="@ResetData" Label="@($"Data Source: {(_useSimpleData ? "simple" : "complex")}")" />
    <FluentButton OnClick="@RebalanceData">Rebalance values</FluentButton>
</FluentStack>

<FluentSankeyChart ChartTitle="Sankey Chart"
                   ChartData="@_chartData"
                   Width="820px"
                   Height="400px"
                   Style="margin-top: 15px;">
</FluentSankeyChart>

