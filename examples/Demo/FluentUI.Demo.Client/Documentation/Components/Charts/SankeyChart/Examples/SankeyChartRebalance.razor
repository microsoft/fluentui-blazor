    private bool _useSimpleData = true;
    private SankeyChartData _chartData = CreateSimpleData();

    private void ResetData() => _chartData = _useSimpleData ? CreateSimpleData() : CreateComplexData();

    private void RebalanceData()
    {
        var source = _useSimpleData ? CreateSimpleData() : CreateComplexData();
        _chartData = source with
        {
            Links = source.Links.Select(link => link with { Value = Math.Max(1, link.Value + _random.Next(-3, 4)) }).ToArray(),
        };
    }

