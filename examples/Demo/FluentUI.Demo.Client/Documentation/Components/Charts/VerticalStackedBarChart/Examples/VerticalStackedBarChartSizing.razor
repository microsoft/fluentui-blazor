@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="vertical-stacked-bar-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="vertical-stacked-bar-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentVerticalStackedBarChart ChartTitle="Vertical stacked bar chart sizing example"
                               ChartData="@data"
                               Width="@($"{_width}px")"
                               Height="@($"{_height}px")" />

@code {
    private int _width = 650;
    private int _height = 350;

    private readonly IReadOnlyList<VerticalStackedBarChartData> data =
    [
        new VerticalStackedBarChartData
        {
            XAxisPoint = 0.0,
            ChartData =
            [
                new VerticalStackedBarChartDataPoint { Legend = "Metadata1", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.11" },
                new VerticalStackedBarChartDataPoint { Legend = "Metadata2", Data = 5, Color = DataVizPalette.Custom, CustomColor = "darkblue" },
                new VerticalStackedBarChartDataPoint { Legend = "Metadata3", Data = 20, Color = DataVizPalette.Custom, CustomColor = "qualitative.6" },
            ],
        },
        new VerticalStackedBarChartData
        {
            XAxisPoint = 20.0,
            ChartData =
            [
                new VerticalStackedBarChartDataPoint { Legend = "Metadata1", Data = 30, Color = DataVizPalette.Custom, CustomColor = "qualitative.11" },
                new VerticalStackedBarChartDataPoint { Legend = "Metadata2", Data = 20, Color = DataVizPalette.Custom, CustomColor = "darkblue" },
                new VerticalStackedBarChartDataPoint { Legend = "Metadata3", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.6" },
            ],
        },
    ];
}
