@page "/Charts/GroupedVerticalBarChart/Debug"
@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div style="margin:20px;display:flex;flex-wrap:wrap;gap:16px 24px;align-items:end;">
    <FluentField LabelPosition="LabelPosition.Above"
                 Style="min-width:220px;flex:1 1 220px;">
        <label slot="label" for="basic-width" id="basic-width--label">
            Width
        </label>
        <FluentSlider slot="input"
                      id="basic-width"
                      min="200"
                      max="1000"
                      @bind-Value="@width">
        </FluentSlider>
        <fluent-label slot="message">@width</fluent-label>
    </FluentField>
    <FluentField LabelPosition="LabelPosition.Above"
                 Style="min-width:220px;flex:1 1 220px;">
        <label slot="label" for="basic-height" id="basic-height--label">
            Height
        </label>
        <FluentSlider slot="input"
                      id="basic-height"
                      min="200"
                      max="1000"
                      @bind-Value="@height">
        </FluentSlider>
        <fluent-label slot="message">@height</fluent-label>
    </FluentField>
    <FluentSwitch Label="Use single color" @bind-Value="useSingleColor"></FluentSwitch>
    <FluentSwitch Label="Enable gradient" @bind-Value="gradient"></FluentSwitch>
    <FluentSwitch Label="Show Y-axis labels" @bind-Value="showYAxisLabels"></FluentSwitch>
    <FluentSwitch Label="Show Y-axis labels tooltip" @bind-Value="showYAxisLabelsTooltip"></FluentSwitch>
    <FluentSwitch Label="Use stack callout" @bind-Value="isCalloutForStack"></FluentSwitch>
    <FluentSwitch Label="Hide labels" @bind-Value="hideLabels"></FluentSwitch>
    <FluentSwitch Label="Hide legends" @bind-Value="hideLegends"></FluentSwitch>
    <FluentSwitch Label="Hide Tooltips" @bind-Value="hideTooltips"></FluentSwitch>
</div>

<div style="margin:20px;">
    <FluentGroupedVerticalBarChart ChartTitle="Grouped vertical bar chart interactive example"
                                   ChartData="@chartData"
                                   Width="@($"{width}px")"
                                   Height="@($"{height}px")"
                                   UseSingleColor="@useSingleColor"
                                   EnableGradient="@gradient"
                                   ShowYAxisLabels="@showYAxisLabels"
                                   ShowYAxisLabelsTooltip="@showYAxisLabelsTooltip"
                                   IsCalloutForStack="@isCalloutForStack"
                                   HideLabels="@hideLabels"
                                   HideTooltip="@hideTooltips"
                                   HideLegends="@hideLegends" />
</div>

@code {
    private readonly IReadOnlyList<GroupedVerticalBarChartData> chartData =
    [
        new GroupedVerticalBarChartData
        {
            XAxisPoint = "Q1",
            Series =
            [
                new GroupedVerticalBarChartDataPoint { Key = "Product A", Legend = "Product A", Data = 25, Color = DataVizPalette.Color1 },
                new GroupedVerticalBarChartDataPoint { Key = "Product B", Legend = "Product B", Data = 35, Color = DataVizPalette.Color2 },
                new GroupedVerticalBarChartDataPoint { Key = "Product C", Legend = "Product C", Data = 18, Color = DataVizPalette.Color3 },
            ],
        },
        new GroupedVerticalBarChartData
        {
            XAxisPoint = "Q2",
            Series =
            [
                new GroupedVerticalBarChartDataPoint { Key = "Product A", Legend = "Product A", Data = 15, Color = DataVizPalette.Color1 },
                new GroupedVerticalBarChartDataPoint { Key = "Product B", Legend = "Product B", Data = 45, Color = DataVizPalette.Color2 },
                new GroupedVerticalBarChartDataPoint { Key = "Product C", Legend = "Product C", Data = 28, Color = DataVizPalette.Color3 },
            ],
        },
    ];

    private int width = 650;
    private int height = 350;
    private bool useSingleColor;
    private bool gradient;
    private bool showYAxisLabels;
    private bool showYAxisLabelsTooltip;
    private bool isCalloutForStack;
    private bool hideLabels = true;
    private bool hideLegends;
    private bool hideTooltips;
}
