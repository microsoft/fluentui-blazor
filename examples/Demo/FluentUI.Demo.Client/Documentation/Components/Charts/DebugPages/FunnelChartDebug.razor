@page "/Charts/FunnelChart/Debug"
@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div style="margin:0 20px;display:flex;flex-wrap:wrap;gap:16px 24px;align-items:end;">
    <FluentSwitch Label="Rounded corners" @bind-Value="roundCorners"></FluentSwitch>
    <FluentSwitch Label="Hide labels" @bind-Value="hideLabels"></FluentSwitch>
    <FluentSwitch Label="Hide legends" @bind-Value="hideLegends"></FluentSwitch>
    <FluentSwitch Label="Allow multiple legend selection" Disabled="@(hideLegends)" @bind-Value="allowMultipleLegendSelection"></FluentSwitch>
    <FluentSwitch Label="Hide Tooltips" @bind-Value="hideTooltips"></FluentSwitch>

</div>
<div style="margin:0  20px; display:block; align-items:center;">
    <FluentRadioGroup Label="Orientation" @bind-Value="orientation">
        <FluentRadio Value="Orientation.Vertical" Label="Vertical"></FluentRadio>
        <FluentRadio Value="Orientation.Horizontal" Label="Horizontal"></FluentRadio>
    </FluentRadioGroup>
    </div>

<div style="margin:20px;">
    <FluentFunnelChart ChartData="@data"
                       ChartTitle="Funnel chart interactive example"
                       HideLabels="@hideLabels"
                       HideTooltip="@hideTooltips"
                       RoundedCorners="@roundCorners"
                       HideLegends="@hideLegends"
                       AllowMultipleLegendSelection="@allowMultipleLegendSelection"
                       Orientation="@orientation" />
</div>

@code {
    private readonly IReadOnlyList<FunnelDataPoint> data = new List<FunnelDataPoint>
    {
            new FunnelDataPoint { Stage = "Visitors", Value = 1000, Color = DataVizPalette.Color5 },
            new FunnelDataPoint { Stage = "Signups", Value = 600, Color = DataVizPalette.Color6 },
            new FunnelDataPoint { Stage = "Trials", Value = 300, Color = DataVizPalette.Color10 },
            new FunnelDataPoint { Stage = "Customers", Value = 250, Color = DataVizPalette.Color3 },
    };

    private bool roundCorners;
    private bool hideLabels = true;
    private bool hideLegends;
    private bool hideTooltips;
    private bool allowMultipleLegendSelection;
    private Orientation orientation;
}
