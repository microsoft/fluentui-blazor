@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="vertical-bar-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="vertical-bar-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentVerticalBarChart ChartTitle="Vertical bar chart sizing example"
                        ChartData="@data"
                        Width="@($"{_width}px")"
                        Height="@($"{_height}px")" />

@code {
    private int _width = 650;
    private int _height = 350;

    private readonly IReadOnlyList<VerticalBarChartDataPoint> data =
    [
        new VerticalBarChartDataPoint { X = 0.0, Y = 10000, Legend = "Oranges", Color = DataVizPalette.Custom, CustomColor = "dodgerblue" },
        new VerticalBarChartDataPoint { X = 10000.0, Y = 50000, Legend = "Dogs", Color = DataVizPalette.Custom, CustomColor = "midnightblue" },
        new VerticalBarChartDataPoint { X = 25000.0, Y = 30000, Legend = "Apples", Color = DataVizPalette.Custom, CustomColor = "darkblue" },
    ];
}
