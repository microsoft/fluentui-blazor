@using Microsoft.FluentUI.AspNetCore.Components.Charts

<p>Resize the container horizontally to see the chart respond to available width.</p>

<div style="width: 700px; max-width: 100%; min-width: 0; resize: horizontal; overflow: auto; border: 1px solid #ddd; padding: 8px; box-sizing: border-box;">
    <FluentVerticalBarChart ChartData="@_chartData"
                            Width="100%"
                            LineLegendText="Line"
                            LineLegendColor="brown"
                            LineBorderWidth="2"
                            Style="min-width: 0;">
    </FluentVerticalBarChart>
</div>

@code {
    private readonly IReadOnlyList<VerticalBarChartDataPoint> _chartData =
    [
        CreatePoint(0, 10000, "Oranges", "qualitative.1", 7000),
        CreatePoint(10000, 50000, "Dogs", "qualitative.2", 30000),
        CreatePoint(25000, 30000, "Apples", "qualitative.3", 3000),
        CreatePoint(40000, 13000, "Bananas", "qualitative.6"),
        CreatePoint(52000, 43000, "Giraffes", "qualitative.11", 30000),
        CreatePoint(68000, 30000, "Cats", "qualitative.2", 5000),
        CreatePoint(80000, 20000, "Elephants", "qualitative.11", 16000),
        CreatePoint(92000, 45000, "Monkeys", "qualitative.6", 40000),
    ];

    private static VerticalBarChartDataPoint CreatePoint(double x, double y, string legend, string color, double? lineY = null) => new()
    {
        X = x,
        Y = y,
        Legend = legend,
        Color = DataVizPalette.Custom,
        CustomColor = color,
        LineData = lineY.HasValue ? new VerticalBarChartLineDataPoint { Y = lineY.Value } : null,
    };
}
