@using System.Globalization
@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div style="margin-bottom: 16px; max-width: 220px;">
    <FluentSelect TOption="string" TValue="string" Label="Culture" @bind-Value="_selectedCulture">
        @foreach (var cultureName in Cultures)
        {
            <FluentOptionString Value="@cultureName">@cultureName</FluentOptionString>
        }
    </FluentSelect>
</div>

<FluentHorizontalBarChart Width="650"
                          ChartTitle="@($"Horizontal bar chart culture example ({_selectedCulture})")"
                          Culture="@SelectedCulture"
                          ChartData="@ChartData">
</FluentHorizontalBarChart>

@code {
    private static readonly string[] Cultures = ["en-US", "de-DE", "fr-FR", "nl-NL", "ja-JP", "ar-SA"];

    private string _selectedCulture = Cultures[0];

    private CultureInfo SelectedCulture => CultureInfo.GetCultureInfo(_selectedCulture);

    private IReadOnlyList<HorizontalBarChartSeries> ChartData =
    [
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Monitored First",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Debit card numbers (EU and USA)", Data = 40, Color = DataVizPalette.Custom, CustomColor = "#0099BC" },
                new HorizontalBarChartDataPoint { Legend = "Passport numbers (USA)",          Data = 23, Color = DataVizPalette.Custom, CustomColor = "#77004D" },
                new HorizontalBarChartDataPoint { Legend = "Social security numbers",         Data = 35, Color = DataVizPalette.Color21 },
                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers",             Data = 87, Color = DataVizPalette.Color10 },
                new HorizontalBarChartDataPoint { Legend = "Tax identification numbers (USA)", Data = 87, Color = DataVizPalette.Custom, CustomColor = "#004E8C" },
            ]
        },
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Monitored Second",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Debit card numbers (EU and USA)", Data = 40, Color = DataVizPalette.Custom, CustomColor = "#0099BC" },
                new HorizontalBarChartDataPoint { Legend = "Passport numbers (USA)",          Data = 56, Color = DataVizPalette.Custom, CustomColor = "#77004D" },
                new HorizontalBarChartDataPoint { Legend = "Social security numbers",         Data = 35, Color = DataVizPalette.Color21 },
                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers",             Data = 92, Color = DataVizPalette.Color10 },
                new HorizontalBarChartDataPoint { Legend = "Tax identification numbers (USA)", Data = 87, Color = DataVizPalette.Custom, CustomColor = "#004E8C" },
            ]
        },
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Unmonitored",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Phone Numbers",       Data = 40, Color = DataVizPalette.Custom, CustomColor = "#881798" },
                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers", Data = 23, Color = DataVizPalette.Color10 },
            ]
        },
    ];
}
