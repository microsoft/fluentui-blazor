@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="horizontal-bar-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="horizontal-bar-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentHorizontalBarChart ChartTitle="Horizontal bar chart sizing example"
                          ChartData="@data"
                          Width="@($"{_width}px")"
                          Height="@($"{_height}px")" />

@code {
    private int _width = 650;
    private int _height = 350;

    private readonly IReadOnlyList<HorizontalBarChartSeries> data =
    [
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Monitored",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Debit card numbers", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.1" },
                new HorizontalBarChartDataPoint { Legend = "Passport numbers", Data = 23, Color = DataVizPalette.Custom, CustomColor = "qualitative.2" },
                new HorizontalBarChartDataPoint { Legend = "Credit card numbers", Data = 87, Color = DataVizPalette.Custom, CustomColor = "qualitative.10" },
            ],
        },
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Unmonitored",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Phone numbers", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.9" },
            ],
        },
    ];
}
