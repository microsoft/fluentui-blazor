@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="funnel-width" Min="200" Max="1000" Step="50" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="funnel-height" Min="200" Max="1000" Step="50" Style="width:300px;" />
</FluentStack>

<FluentCheckbox @bind-Value="@_hideLegends" Label="Hide legends" />

<FluentFunnelChart ChartTitle="Basic Funnel Chart"
                   ChartData="@chartData"
                   Width=@($"{_width}px")
                   Height=@($"{_height}px")
                   Orientation="Orientation.Horizontal">
</FluentFunnelChart>

@code {
    private int _width = 600;
    private bool _hideLegends = true;
    private int _height = 500;

    private readonly IReadOnlyList<FunnelDataPoint> chartData =
    [
        new FunnelDataPoint { Stage = "Visitors", Value = 1000 },
        new FunnelDataPoint { Stage = "Signups", Value = 600 },
        new FunnelDataPoint { Stage = "Trials", Value = 300 },
        new FunnelDataPoint { Stage = "Customers", Value = 250 },
    ];
}

