@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentCheckbox @bind-Value="@_hideTooltip" Label="Hide tooltip" />

<FluentVerticalStackedBarChart ChartTitle="Vertical stacked bar chart basic example"
