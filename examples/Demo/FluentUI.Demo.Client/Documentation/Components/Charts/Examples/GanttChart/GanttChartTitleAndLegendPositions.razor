@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Style="margin-bottom: 16px;">
    <FluentSelect Label="Title position"
                  Items="@(Enum.GetValues<ChartTitlePosition>())"
                  @bind-Value="@_titlePosition" />
    <FluentSelect Label="Legend position"
                  Items="@(Enum.GetValues<ChartLegendPosition>())"
                  @bind-Value="@_legendPosition" />
</FluentStack>


<FluentGanttChart ChartTitle="Gantt Chart"
                  ChartData="@chartData"
                  Width="600px"
                  Height="350px"
                  ShowYAxisLabels="true"
                 TitlePosition="@_titlePosition"
                 LegendPosition="@_legendPosition">
</FluentGanttChart>

@code {
    private ChartTitlePosition _titlePosition = ChartTitlePosition.Top;
    private ChartLegendPosition _legendPosition = ChartLegendPosition.Top;

    private readonly IReadOnlyList<GanttChartDataPoint> chartData =
    [
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2009, 1, 1), End = new DateTime(2009, 2, 28) },
            Y = "Job A",
            Legend = "Alex",
            Color = DataVizPalette.Color1,
        },
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2009, 3, 5), End = new DateTime(2009, 4, 15) },
            Y = "Job B",
            Legend = "Alex",
            Color = DataVizPalette.Color1,
        },
        new GanttChartDataPoint
        {
            X = new GanttChartXRange { Start = new DateTime(2009, 2, 20), End = new DateTime(2009, 5, 30) },
            Y = "Job C",
            Legend = "Max",
            Color = DataVizPalette.Color2,
        },
    ];
}



