@using Microsoft.FluentUI.AspNetCore.Components.Charts
@inject IJSRuntime JS

<FluentGanttChart Style="width: 600px; height: 350px"
                  ChartTitle="Gantt chart custom tooltip example"
                  ShowYAxisLabels="true"
                  ChartData="@ChartData">
    <CartesianTooltipTemplate Context="ctx">
        <div style="padding: 8px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 180px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span style="width: 10px; height: 10px; border-radius: 2px; background-color: @ctx.Color.ToDataVizPaletteHex(ctx.CustomColor, _isDark); flex-shrink: 0;"></span>
                <strong>@ctx.Legend</strong>
            </div>
            <div style="font-size: 0.85em;">Task: <strong>@ctx.YValue</strong></div>
            @{
                var start = DateTime.TryParse(ctx.XStart, out var s) ? s.ToString("MMM d, yyyy") : ctx.XStart;
                var end   = DateTime.TryParse(ctx.XEnd,   out var e) ? e.ToString("MMM d, yyyy") : ctx.XEnd;
            }
            <div style="font-size: 0.85em;">From: <strong>@start</strong></div>
            <div style="font-size: 0.85em;">To: <strong>@end</strong></div>
        </div>
    </CartesianTooltipTemplate>
</FluentGanttChart>

@code {
    private bool _isDark;

    private IReadOnlyList<GanttChartDataPoint> ChartData =
    [
        new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 1, 1),  End = new DateTime(2009, 2, 28) }, Y = "Job A", Legend = "Alex", Color = DataVizPalette.Color1 },
        new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 3, 5),  End = new DateTime(2009, 4, 15) }, Y = "Job B", Legend = "Alex", Color = DataVizPalette.Color1 },
        new GanttChartDataPoint { X = new GanttChartXRange { Start = new DateTime(2009, 2, 20), End = new DateTime(2009, 5, 30) }, Y = "Job C", Legend = "Max",  Color = DataVizPalette.Color2 },
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDark = await JS.InvokeAsync<bool>("Blazor.theme.isDarkMode");
            StateHasChanged();
        }
    }
}
