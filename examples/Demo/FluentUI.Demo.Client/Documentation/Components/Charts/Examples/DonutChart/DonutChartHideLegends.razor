@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentDonutChart ChartData="@data"
                  ChartTitle="Donut chart hide legends example"
                  HideLegends="true"
                  ValueInsideDonut="39,000"
                  InnerRadius="55" />

@code {
    private readonly IReadOnlyList<DonutDataPoint> data = new List<DonutDataPoint>
    {
        new DonutDataPoint { Legend = "first", Data = 20000 },
        new DonutDataPoint { Legend = "second", Data = 39000 }
    };
}
