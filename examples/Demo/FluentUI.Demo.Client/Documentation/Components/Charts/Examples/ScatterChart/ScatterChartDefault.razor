                    Width="650px"
                    Height="350px"
                    XAxisTitle="Days since project start"
                    YAxisTitle="Revenue in dollars"
                    XMinValue="0"
                    XMaxValue="110"
                    YMinValue="0"
                    YMaxValue="325000"
                    TickValues="@xAxisTicks"
                    YAxisTickValues="@yAxisTicks">
</FluentScatterChart>

