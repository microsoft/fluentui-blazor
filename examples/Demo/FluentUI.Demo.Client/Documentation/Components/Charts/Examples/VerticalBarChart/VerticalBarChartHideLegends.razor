@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="vertical-bar-width" Min="200" Max="1000" Step="50" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="vertical-bar-height" Min="200" Max="1000" Step="50" Style="width:300px;" />
</FluentStack>

<FluentCheckbox @bind-Value="@_hideLegends" Label="Hide legends" />

<FluentVerticalBarChart ChartTitle="Vertical bar chart basic example"
                        ChartData="@chartData"
                        Width=@($"{_width}px")
                        Height=@($"{_height}px")
                        LineLegendText="just line"
                        LineLegendColor="brown"
                        LineBorderWidth="2">
</FluentVerticalBarChart>

