@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentGaugeChart ChartTitle="Gauge chart segment aria-label example"
                  Segments="@_chartData"
                  ChartValue="45"
                  MaxValue="100"
                  Width="252px"
                  Height="173px">
</FluentGaugeChart>

@code {
    private readonly IReadOnlyList<GaugeChartSegment> _chartData =
    [
        new GaugeChartSegment
        {
            Legend = "Low",
            Size = 33,
            Color = DataVizPalette.Color1,
            AriaLabel = "Custom label for Low",
        },
        new GaugeChartSegment
        {
            Legend = "Medium",
            Size = 34,
            Color = DataVizPalette.Color3,
            AriaLabel = "Custom label for Medium",
        },
        new GaugeChartSegment
        {
            Legend = "High",
            Size = 33,
            Color = DataVizPalette.Color2,
            AriaLabel = "Custom label for High",
        },
    ];
}
