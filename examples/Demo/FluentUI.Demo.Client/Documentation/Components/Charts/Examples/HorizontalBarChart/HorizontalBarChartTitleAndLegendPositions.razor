@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Style="margin-bottom: 16px;">
    <FluentSelect Label="Title position"
                  Items="@(Enum.GetValues<ChartTitlePosition>())"
                  @bind-Value="@_titlePosition" />
    <FluentSelect Label="Legend position"
                  Items="@(Enum.GetValues<ChartLegendPosition>())"
                  @bind-Value="@_legendPosition" />
</FluentStack>


<FluentHorizontalBarChart Width="650px"
                          ChartTitle="Horizontal bar chart basic example"
                          ChartData="@chartData"
                 TitlePosition="@_titlePosition"
                 LegendPosition="@_legendPosition">
</FluentHorizontalBarChart>

@code {
    private ChartTitlePosition _titlePosition = ChartTitlePosition.Top;
    private ChartLegendPosition _legendPosition = ChartLegendPosition.Top;

    private readonly IReadOnlyList<HorizontalBarChartSeries> chartData =
    [
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Monitored First",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Debit card numbers (EU and USA)", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.1" },
                new HorizontalBarChartDataPoint { Legend = "Passport numbers (USA)", Data = 23, Color = DataVizPalette.Custom, CustomColor = "qualitative.2" },
                new HorizontalBarChartDataPoint { Legend = "Social security numbers", Data = 35, Color = DataVizPalette.Custom, CustomColor = "qualitative.3" },
                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers", Data = 87, Color = DataVizPalette.Custom, CustomColor = "qualitative.10" },
                new HorizontalBarChartDataPoint { Legend = "Tax identification numbers (USA)", Data = 87, Color = DataVizPalette.Custom, CustomColor = "qualitative.4" },
            ],
        },
        new HorizontalBarChartSeries
        {
            ChartSeriesTitle = "Monitored Second",
            ChartData =
            [
                new HorizontalBarChartDataPoint { Legend = "Debit card numbers (EU and USA)", Data = 40, Color = DataVizPalette.Custom, CustomColor = "qualitative.1" },
                new HorizontalBarChartDataPoint { Legend = "Passport numbers (USA)", Data = 56, Color = DataVizPalette.Custom, CustomColor = "qualitative.2" },
                new HorizontalBarChartDataPoint { Legend = "Social security numbers", Data = 35, Color = DataVizPalette.Custom, CustomColor = "qualitative.3" },
                new HorizontalBarChartDataPoint { Legend = "Credit card Numbers", Data = 92, Color = DataVizPalette.Custom, CustomColor = "qualitative.10" },
                new HorizontalBarChartDataPoint { Legend = "Tax identification numbers (USA)", Data = 87, Color = DataVizPalette.Custom, CustomColor = "qualitative.4" },
