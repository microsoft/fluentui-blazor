@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentSwitch @bind-Value="@_allowMultipleShapesForPoints" Label="Multiple shapes" />

<FluentLineChart ChartTitle="Line Chart"
                 ChartData="@_chartData"
                 Width="700px"
                 Height="300px"
                 UseUTC="true"
                 TickFormat="%m/%d"
                 DateTickValues="@_dates"
                 YAxisTickFormat="$,"
                 YMinValue="282"
                 YMaxValue="301"
                 EventAnnotationProps="@_eventAnnotationProps"
                 AllowMultipleShapesForPoints="@_allowMultipleShapesForPoints">
</FluentLineChart>

@code {
    private static readonly DateTime[] _dates = Enumerable.Range(0, 7)
        .Select(index => new DateTime(2020, 3, 3 + index, 0, 0, 0, DateTimeKind.Utc))
        .ToArray();

    private bool _allowMultipleShapesForPoints;

    private readonly IReadOnlyList<LineChartSeries> _chartData =
    [
        new LineChartSeries
        {
            Legend = "From_Legacy_to_O365",
            Color = DataVizPalette.Custom,
            CustomColor = "qualitative.8",
            LineOptions = new LineChartLineOptions { LineBorderWidth = 4 },
            Data = CreatePoints([297, 284, 282, 294, 294, 300, 298]),
        },
        new LineChartSeries
        {
            Legend = "All",
            Color = DataVizPalette.Custom,
            CustomColor = "qualitative.10",
            LineOptions = new LineChartLineOptions { LineBorderWidth = 4 },
            Data = CreatePoints([292, 287, 287, 292, 287, 297, 292]),
        },
    ];

    private readonly string _eventAnnotationProps =
        @"
        {
          ""events"": [
            { ""event"": ""event 1"", ""date"": ""2020-03-04T00:00:00.000Z"", ""cardContent"": ""event 1 message"" },
            { ""event"": ""event 2"", ""date"": ""2020-03-04T00:00:00.000Z"", ""cardContent"": ""event 2 message"" },
            { ""event"": ""event 3"", ""date"": ""2020-03-04T00:00:00.000Z"", ""cardContent"": ""event 3 message"" },
            { ""event"": ""event 4"", ""date"": ""2020-03-06T00:00:00.000Z"", ""cardContent"": ""event 4 message"" },
            { ""event"": ""event 5"", ""date"": ""2020-03-08T00:00:00.000Z"", ""cardContent"": ""event 5 message"" }
          ],
          ""labelHeight"": 18,
          ""labelWidth"": 50,
          ""mergedLabel"": ""{count} events""
        }
        ";

    private static IReadOnlyList<LineChartDataPoint> CreatePoints(double[] values) => values
        .Select((y, index) => new LineChartDataPoint
        {
            X = _dates[index],
            Y = y,
        })
        .ToArray();
}
