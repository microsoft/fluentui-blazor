@using Microsoft.FluentUI.AspNetCore.Components.Charts

<div>
    A sparkline
    <FluentSparklineChart ChartData="@sparklineExamples[0]"
                          Width="80px"
                          Height="20px"
                          ShowLegend="true"
                          Style="display: inline-block;">
    </FluentSparklineChart>
    - is a very small line chart, drawn without axes or coordinates. It presents the general shape of the variation (like over time) in some measurement,
    <FluentSparklineChart ChartData="@sparklineExamples[1]"
                          Width="80px"
                          Height="20px"
                          Style="display: inline-block;">
    </FluentSparklineChart>
    - such as temperature or stock market price, in a simple and highly condensed way.
    <br />
    <br />
    Below table shows sparklines in one of its columns.
    <br />
    <br />
</div>

<table role="grid">
    <tbody>
        @for (var index = 0; index < sparklineExamples.Count; index++)
        {
            <tr>
                <td style="padding-block:5px;padding-inline-end:15px;">Row @(index + 1)</td>
                <td>
                    <FluentSparklineChart ChartData="@sparklineExamples[index]"
                                          Width="80px"
                                          Height="20px"
                                          ShowLegend="@(index < 2 || index > 4)">
                    </FluentSparklineChart>
                </td>
            </tr>
        }
    </tbody>
</table>

