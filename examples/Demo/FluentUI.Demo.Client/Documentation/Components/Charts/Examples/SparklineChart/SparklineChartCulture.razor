@using Microsoft.FluentUI.AspNetCore.Components.Charts
@using System.Globalization

<div style="margin-bottom: 16px; max-width: 220px;">
    <FluentSelect TOption="string" TValue="string" Label="Culture" @bind-Value="_selectedCulture">
        @foreach (var cultureName in Cultures)
        {
            <FluentOptionString Value="@cultureName">@cultureName</FluentOptionString>
        }
    </FluentSelect>
</div>

<FluentSparklineChart ChartData="@sparklineData"
                      Width="650px"
                      Height="350px"
                      Culture="@SelectedCulture"
                      ShowLegend="true"
                      Style="display: block;">
</FluentSparklineChart>

@code {
    private static readonly string[] Cultures = ["en-US", "de-DE", "fr-FR", "nl-NL", "ja-JP", "ar-SA"];

    private string _selectedCulture = Cultures[0];

    private readonly SparklineChartData sparklineData = new()
    {
        ChartTitle = "10.21",
        LineChartData =
        [
            new SparklineChartSeries
            {
                Legend = "19.64",
                Color = DataVizPalette.Custom,
                CustomColor = "qualitative.1",
                Data =
                [
                    new SparklineDataPoint { X = 1.0, Y = 58.13 },
                    new SparklineDataPoint { X = 2.0, Y = 140.98 },
                    new SparklineDataPoint { X = 3.0, Y = 20 },
                    new SparklineDataPoint { X = 4.0, Y = 89.7 },
                    new SparklineDataPoint { X = 5.0, Y = 99 },
                    new SparklineDataPoint { X = 6.0, Y = 13.28 },
                    new SparklineDataPoint { X = 7.0, Y = 31.32 },
                    new SparklineDataPoint { X = 8.0, Y = 10.21 },
                ],
            },
        ],
    };

    private CultureInfo SelectedCulture => CultureInfo.GetCultureInfo(_selectedCulture);
}



