@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="heat-map-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="heat-map-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentHeatMapChart ChartTitle="Heat map chart sizing example"
                    ChartData="@data"
                    Width="@($"{_width}px")"
                    Height="@($"{_height}px")" />

@code {
    private int _width = 450;
    private int _height = 378;

    private readonly IReadOnlyList<HeatMapChartData> data =
    [
        new HeatMapChartData
        {
            Value = 100,
            Legend = "Excellent (0-200)",
            Data =
            [
                new HeatMapChartDataPoint { X = new DateTime(2020, 3, 3), Y = "Texas", Value = 46, RectText = "46" },
                new HeatMapChartDataPoint { X = new DateTime(2020, 3, 4), Y = "Ohio", Value = 60, RectText = "60" },
            ],
        },
        new HeatMapChartData
        {
            Value = 250,
            Legend = "Good (201-300)",
            Data =
            [
                new HeatMapChartDataPoint { X = new DateTime(2020, 3, 3), Y = "Alaska", Value = 265, RectText = "265" },
                new HeatMapChartDataPoint { X = new DateTime(2020, 3, 4), Y = "Ohio", Value = 310, RectText = "310" },
            ],
        },
    ];
}
