@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
        <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="grouped-vertical-bar-line-width" Min="200" Max="1000" Step="10" Style="width:300px;" />
        <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="grouped-vertical-bar-line-height" Min="200" Max="1000" Step="10" Style="width:300px;" />
    </FluentStack>

    <FluentRadioGroup Label="Pick a callout variant"
                      @bind-Value="_calloutVariant"
                      Name="grouped-vertical-bar-line-callout">
        <FluentRadio Value="@CalloutVariant.Single">Single Callout</FluentRadio>
        <FluentRadio Value="@CalloutVariant.Stacked">Stacked Callout</FluentRadio>
    </FluentRadioGroup>
</FluentStack>

<FluentGroupedVerticalBarChart ChartTitle="Grouped Vertical Bar chart line example"
                               ChartData="@chartData"
                               Width="@($"{_width}px")"
                               Height="@($"{_height}px")"
                               SupportNegativeData="true"
                               LineBorderWidth="2"
                               CalloutVariant="@_calloutVariant"
                               Style="margin-top:20px;">
</FluentGroupedVerticalBarChart>

