@using Microsoft.FluentUI.AspNetCore.Components.Charts

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4">
    <FluentSlider Label=@($"Width: {_width}") @bind-Value="_width" Id="grouped-vertical-bar-width" Min="200" Max="1000" Step="25" Style="width:300px;" />
    <FluentSlider Label=@($"Height: {_height}") @bind-Value="_height" Id="grouped-vertical-bar-height" Min="200" Max="1000" Step="25" Style="width:300px;" />
</FluentStack>

<FluentGroupedVerticalBarChart ChartTitle="Grouped vertical bar chart sizing example"
                               ChartData="@data"
                               Width="@($"{_width}px")"
                               Height="@($"{_height}px")" />

@code {
    private int _width = 650;
    private int _height = 350;

    private readonly IReadOnlyList<GroupedVerticalBarChartData> data = new List<GroupedVerticalBarChartData>
    {
        new GroupedVerticalBarChartData
        {
            XAxisPoint = "Jan - Mar",
            Series = new List<GroupedVerticalBarChartDataPoint>
            {
                new GroupedVerticalBarChartDataPoint { Key = "2023", Data = 44000, Color = DataVizPalette.Color5 },
                new GroupedVerticalBarChartDataPoint { Key = "2024", Data = 54000, Color = DataVizPalette.Color6 },
            },
        },
        new GroupedVerticalBarChartData
        {
            XAxisPoint = "Apr - Jun",
            Series = new List<GroupedVerticalBarChartDataPoint>
            {
                new GroupedVerticalBarChartDataPoint { Key = "2023", Data = 3000, Color = DataVizPalette.Color5 },
                new GroupedVerticalBarChartDataPoint { Key = "2024", Data = 9000, Color = DataVizPalette.Color6 },
            },
        },
    };
}
