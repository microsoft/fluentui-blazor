@inject IDialogService DialogService

<FluentButton OnClick="@ShowSplashScreenAsync"
              Appearance="ButtonAppearance.Primary">Show Splash Screen</FluentButton>

@code
{
    private async Task ShowSplashScreenAsync()
    {
        var splash = await DialogService.ShowSplashScreenAsync<Dialog.SplashScreenDialog>(options =>
        {
            options.Parameters.Add(nameof(Dialog.SplashScreenDialog.Message), "Loading...");
        });

        await Task.Delay(2000);
        await splash.UpdateAsync(options => options.Parameters[nameof(Dialog.SplashScreenDialog.Message)] = "Almost ready...");

        await Task.Delay(2000);
        await splash.UpdateAsync(options => options.Parameters[nameof(Dialog.SplashScreenDialog.Message)] = "Hello World");

        await Task.Delay(1000);
        await splash.CloseAsync();
    }
}
