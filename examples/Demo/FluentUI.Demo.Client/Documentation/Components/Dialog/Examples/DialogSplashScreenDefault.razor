@inject IDialogService DialogService

<FluentButton OnClick="OpenSplashDefaultAsync" Appearance="ButtonAppearance.Primary">Open default splash screen</FluentButton>

@code {
    private async Task OpenSplashDefaultAsync()
    {
        var content = new SplashScreenContent
        {
            Title = "Main title",
            SubTitle = "A subtitle here",
            LoadingText = "Loading...",
            Message = (MarkupString)"some <i>extra</i> text <strong>here</strong>",
        };

        var task = DialogService.ShowSplashScreenAsync(content, options =>
        {
            options.Width = "640px";
            options.Height = "480px";
        });

        await Task.Delay(2000);
        content.UpdateLabels("Second task...", (MarkupString)"Processing the <i>next</i> step...");
        await Task.Delay(2000);

        var result = await task;
        Console.WriteLine($"Splash screen closed. Cancelled={result.Cancelled}");
    }
}
