<div style="background-color: var(--colorNeutralBackground4); overflow: auto; resize: horizontal; border: 1px solid darkgray; margin-bottom: 10px;">
    <FluentOverflow OnOverflowRaised="OverflowHandler" Style="display: flex; align-items: center; width: 100%;  padding: 2px; margin-bottom: 4px;">
        <ChildContent>
            @foreach (var item in Items)
            {
                <FluentLabel Style="border:dashed 1px red; padding: 2px;">@item</FluentLabel>
            }
        </ChildContent>
        <MoreTemplate>
            <FluentButton Appearance="ButtonAppearance.Subtle" Style="height: 20px; min-width: 32px; max-width:32px;">@($"+{context.ItemsOverflow.Count()}")</FluentButton>
        </MoreTemplate>
        <OverflowTemplate>
            <FluentTooltip Anchor="@context.IdMoreButton" UseTooltipService="false">
                <div style="display: flex; flex-direction: column; align-items: flex-start; width: max-content;">
                    @foreach (var item in context.ItemsOverflow)
                    {
                        <FluentLabel Style="border:dashed 1px red; padding: 2px; margin: 3px;">@item.Text</FluentLabel>
                    }
                </div>
            </FluentTooltip>
        </OverflowTemplate>
    </FluentOverflow>
</div>

<FluentButton @onclick="@AddNewItemClick">Add</FluentButton>
<FluentButton @onclick="@RemoveLastItemClick">Remove</FluentButton>

@code
{
    static string[] Catalog = new[] { "Blazor", "WPF", "Microsoft", "Framework",
                                      "Electron", "WinForms", "MAUI", "Fluent", "Reality",
                                      "Office", "Installation", "Azure", "DevOps" };

    List<string> Items = new List<string>() { Catalog[0], Catalog[1] };

    void OverflowHandler(IEnumerable<OverflowItem> items)
    {
        var text = String.Join("; ", items.Select(i => i.Text));

    }

    void AddNewItemClick()
    {
        var index = new Random().NextInt64(Catalog.Length);
        Items.Add(Catalog[index]);
    }

    void RemoveLastItemClick()
    {
        Items.RemoveAt(Items.Count-1);
    }
}
