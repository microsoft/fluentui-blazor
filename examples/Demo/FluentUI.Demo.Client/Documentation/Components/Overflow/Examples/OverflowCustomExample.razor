<div class="resizable-horizontal">
    <FluentOverflow TItem="string"
                    OnOverflowRaised="OverflowHandler">
        <ChildContent>
            @foreach (var item in Items)
            {
                <FluentLabel Class="overflow-item">@item</FluentLabel>
            }
        </ChildContent>
        <MoreTemplate>
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          Style="min-width: 32px; max-width:32px;">
                @($"+{context.ItemsOverflow.Count()}")
            </FluentButton>
        </MoreTemplate>
        <OverflowTemplate>
            <FluentTooltip Anchor="@context.IdMoreButton"
                           UseTooltipService="false"
                           Positioning="Positioning.BelowStart"
                           Style="flex-direction: column; row-gap: 4px;">
                @foreach (var item in context.ItemsOverflow)
                {
                    <FluentLabel>@item.Text</FluentLabel>
                }
            </FluentTooltip>
        </OverflowTemplate>
    </FluentOverflow>
</div>

<FluentButton OnClick="@AddNewItemClick">
    Add
</FluentButton>
<FluentButton OnClick="@RemoveLastItemClick">
    Remove
</FluentButton>

@code
{
    static string[] Catalog = new[] { "Blazor", "WPF", "Microsoft", "Framework",
                                      "Electron", "WinForms", "MAUI", "Fluent", "Reality",
                                      "Office", "Installation", "Azure", "DevOps" };

    List<string> Items = new List<string>() { Catalog[0], Catalog[1] };

    void OverflowHandler(IEnumerable<OverflowItem> items)
    {
        var text = String.Join("; ", items.Select(i => i.Text));
        Console.WriteLine($"Overflow raised with items: {text}");
    }

    void AddNewItemClick()
    {
        var index = new Random().NextInt64(Catalog.Length);
        Items.Add(Catalog[index]);
    }

    void RemoveLastItemClick()
    {
        Items.RemoveAt(Items.Count - 1);
    }
}


<style>
    .overflow-item {
        background: var(--colorNeutralBackground2);
        border: dashed 1px var(--colorNeutralBackground2Selected);
        padding: 2px 8px;
    }
</style>