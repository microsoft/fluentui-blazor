@inject IDialogService DialogService

<FluentButton OnClick="@ShowSplashScreenAsync"
              Appearance="ButtonAppearance.Primary">Show (6 secondes)</FluentButton>

<FluentButton OnClick="@ShowProgressAsync"
              Appearance="ButtonAppearance.Default">Show Progress</FluentButton>

<FluentButton OnClick="@ShowLightAsync"
              Appearance="ButtonAppearance.Default">Show Light</FluentButton>


@code
{
    private async Task ShowSplashScreenAsync()
    {
        var splash = await DialogService.ShowSplashScreenAsync(content =>
        {
            content.LogoUrl = "/images/splash-corporation-logo.png";
            content.LogoMaxWidth = "400px";
            content.Title = "Microsoft Fluent UI Blazor";
            content.SubTitle = "Powered by you";
            content.LoadingText = "Loading...";
        });

        await Task.Delay(2000);
        await splash.UpdateAsync(content => content.LoadingText = "Almost ready...");

        await Task.Delay(2000);
        await splash.UpdateAsync(content => content.LoadingText = "Again almost ready...");

        await Task.Delay(2000);
        await splash.CloseAsync();
    }

    private async Task ShowProgressAsync()
    {
        var splash = await DialogService.ShowSplashScreenAsync(content =>
        {
            content.LogoUrl = "/images/splash-corporation-logo.png";
            content.LogoMaxWidth = "400px";
            content.Title = "Microsoft Fluent UI Blazor";
            content.SubTitle = "Powered by you";
            content.LoadingText = "Loading...";
            content.LoadingPercentage = 0; // 👈 Activate the progress bar
        });

        for (int i = 0; i <= 100; i += 10)
        {
            await Task.Delay(500);
            await splash.UpdateAsync(content =>
            {
                content.LoadingPercentage = i;
                content.LoadingText = $"Loading... {i}%";
            });
        }

        await Task.Delay(500);
        await splash.CloseAsync();
    }

    private async Task ShowLightAsync()
    {
        var splash = await DialogService.ShowSplashScreenAsync(content =>
        {
            content.Title = "Microsoft Fluent UI Blazor";
            content.LoadingText = "Loading...";
        });

        await Task.Delay(4000);
        await splash.CloseAsync();
    }
}
