<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 VerticalGap="16px"
                 Style="padding: 24px;">
        <FluentSpinner />
        <FluentText>@SplashScreen.Message</FluentText>
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public required SplashScreenContent SplashScreen { get; set; }
}
