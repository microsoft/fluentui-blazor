@inject INotificationService NotificationService

<FluentStack Wrap="true" HorizontalGap="12px">
    @* <FluentButton OnClick="@(() => OpenToastAsync(ToastIntent.Info))">
        Show Info
    </FluentButton> *@
    <FluentButton OnClick="@(() => NotificationService.ShowSuccessToastAsync($"Success toast #{counter++}", "This toast has a default success style.", 5))">
        Show Success
    </FluentButton>
    @* <FluentButton OnClick="@(() => OpenToastAsync(ToastIntent.Warning))">
        Show Warning
    </FluentButton>
    <FluentButton OnClick="@(() => OpenToastAsync(ToastIntent.Error))">
        Show Error
    </FluentButton>
    <FluentButton OnClick="@(() => OpenToastAsync(ToastIntent.Progress))">
        Show Progress
    </FluentButton> *@
</FluentStack>

@code {

    int counter = 1;
}

