@inject IJSRuntime JS
@using FluentUI.Demo.SampleData
@using static FluentUI.Demo.SampleData.DateAndTime  @* To use MonthItem *@

<FluentTabs @bind-ActiveTabId="@SelectedTabId" Style="@CommonStyles.NeutralBorder1">

    @foreach (var item in Items)
    {
        <FluentTab Id="@item.Index"
                   aria-description="Press Delete to remove this tab"
                   @onkeydown="@(e => OnTabKeyDown(e, item.Index))">

            @* Tab Header *@
            <HeaderTemplate>
                <FluentStack HorizontalGap="4px" VerticalAlignment="VerticalAlignment.Center">
                    <FluentLabel>@item.Name</FluentLabel>
                    <FluentIcon Tooltip="Delete"
                                Value="@(new Icons.Regular.Size12.Dismiss())"
                                OnClick="@(e => RemoveTab(item.Index))" />
                </FluentStack>
            </HeaderTemplate>

            @* Tab Content *@
            <ChildContent>
                Tab #@item.Index: @item.Name
            </ChildContent>

        </FluentTab>
    }

</FluentTabs>

<FluentButton Id="@AddButtonId" OnClick="AddTab" Disabled="@(Items.Count > 11)">Add and select</FluentButton>

@code
{
    List<MonthItem> Items = new List<MonthItem>(DateAndTime.AllMonths.Take(4));
    string? SelectedTabId;

    void AddTab()
    {
        var newItem = DateAndTime.AllMonths.FirstOrDefault(month => !Items.Any(item => item.Index == month.Index));
        if (newItem != null)
        {
            Items.Add(newItem);
            SelectedTabId = newItem.Index;
        }
    }

    const string AddButtonId = "tabs-dynamic-add";
    string? FocusElementId;

    void OnTabKeyDown(KeyboardEventArgs e, string tabId)
    {
        if (e.Key != "Delete")
        {
            return;
        }

        RemoveTab(tabId);

        // Move the focus to the newly selected tab (or to the "Add and select" button when no tabs remain),
        // so keyboard users don't lose their position.
        FocusElementId = SelectedTabId ?? AddButtonId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusElementId is not null)
        {
            var elementId = FocusElementId;
            FocusElementId = null;

            await using var element = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", elementId);
            await element.InvokeVoidAsync("focus");
        }
    }

    void RemoveTab(string tabId)
    {
        var item = Items.FirstOrDefault(i => i.Index == tabId);
        if (item != null)
        {
            Items.Remove(item);
            SelectedTabId = Items.FirstOrDefault()?.Index;
        }
    }
}
