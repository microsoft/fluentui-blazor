<FluentNav UseIcons="true"
           UseSingleExpanded="true"
           OnItemClick="@(e => Console.WriteLine($"NavItem clicked: '{e.IconRest?.Name}'."))"
           Width="260px"
           Density="NavDensity.Medium">
    <!-- Navigation Items -->
    <FluentNavItem IconRest="@((new Icons.Regular.Size20.Board().WithColor(Color.Error)))" IconActive="@((new Icons.Filled.Size20.Board().WithColor(Color.Success)))">
        Dashboard
    </FluentNavItem>
    <FluentNavItem Disabled="true">Employee Spotlight</FluentNavItem>
    <FluentNavItem Href="/sticker-sheet" IconRest="@((new Icons.Regular.Size20.PersonMoney()))" IconActive="@((new Icons.Filled.Size20.PersonMoney()))">
        Performance Reviews
    </FluentNavItem>

    <!-- Employee Management -->
    <FluentNavSectionHeader Title="Employee Management" />

    <FluentNavCategory Title="Job Postings" IconRest="@((new Icons.Regular.Size20.NotePin().WithColor(Color.Error)))" IconActive="@((new Icons.Filled.Size20.NotePin().WithColor(Color.Success)))">
        <FluentNavItem>Openings</FluentNavItem>
        <FluentNavItem>Submissions</FluentNavItem>
    </FluentNavCategory>
</FluentNav>
