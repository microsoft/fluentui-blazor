<div class="sticker-row">

    <FluentTimePicker Label="Meeting time"
                      DisabledTimeFunc="@(date => date?.Hour == 12)"
                      @bind-Value="@SelectedValue" />
</div>
<div>
    <b>Selected time:</b> @(SelectedValue?.ToString("yyyy-MM-dd HH:mm"))
</div>

@code
{
    DateTime? SelectedValue;
}
