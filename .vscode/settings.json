{
    // Settings for the Dotnet Pulse extension: F5 or Ctrl+F5 to run/debug the project.
    "dotnetPulse.documentationUrls": [
        { "label": "Web Component", "url": "https://storybooks.fluentui.dev/web-components" },
        { "label": "Fluent UI Blazor", "url": "https://fluentui-blazor.net/" }
    ],
    "dotnetPulse.projectBuildToConsole": "externalTerminal",
    "dotnetPulse.projectUri": "examples/Demo/FluentUI.Demo/FluentUI.Demo.csproj",
    "dotnetPulse.buildArgs": [
        "--configuration",
        "Debug",
        "--no-restore",
        "-m"
    ],
    "dotnetPulse.runBuildArgs": [
        "--configuration",
        "Debug",
        "--no-restore",
        "-m",
        "-p:RunAnalyzersDuringBuild=false",
        "-p:EnforceCodeStyleInBuild=false",
        "-p:CompressionEnabled=false"
    ],

    // C# Dev Kit: solution open by default 
    "dotnet.defaultSolution": "Microsoft.FluentUI-v5.slnx"
}