    [Fact]
    public void FluentHorizontalBarChartWithAxis_Default()
    {
        // Arrange && Act
        var cut = Render(@<FluentHorizontalBarChartWithAxis ChartData="@DefaultData" />);

        // Assert
        cut.Verify();
    }

