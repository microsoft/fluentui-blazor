    [Fact]
    public void FluentHorizontalBarChartWithAxis_TooltipTemplate()
    {
        // Arrange && Act
        var cut = Render(
            @<FluentHorizontalBarChartWithAxis ChartData="@DefaultData">
                <TooltipTemplate Context="ctx">
                    <span>@ctx.Legend: @ctx.YValue</span>
                </TooltipTemplate>
            </FluentHorizontalBarChartWithAxis>
        );

        // Assert — portal div is present when TooltipTemplate is set
        Assert.NotNull(cut.Find("[style*='display:none']"));
    }

