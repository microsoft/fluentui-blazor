@page "/list/listbox/selection"

<FluentListbox Id="colors" Label="Color" Items="@Colors"
               @bind-Value="@Value" @bind-Value:after="@OnValueChangedAsync" />

<span data-testid="current-value">@Value</span>
<span data-testid="change-count">@ChangeCount</span>

<FluentListbox TOption="string" TValue="string" Id="multiple-colors" Label="Colors" Items="@Colors" Multiple="true"
               @bind-SelectedItems="@SelectedColors" @bind-SelectedItems:after="@OnSelectedColorsChanged" />

<span data-testid="selected-colors">@string.Join(", ", SelectedColors)</span>
<span data-testid="multiple-change-count">@MultipleChangeCount</span>

@code
{
    private readonly string[] Colors = ["Red", "Green", "Blue"];
    private string? Value = "Green";
    private int ChangeCount;
    private IEnumerable<string> SelectedColors = [];
    private int MultipleChangeCount;

    private async Task OnValueChangedAsync()
    {
        ChangeCount++;
        await Task.Delay(50);
    }

    private void OnSelectedColorsChanged()
    {
        MultipleChangeCount++;
    }
}
