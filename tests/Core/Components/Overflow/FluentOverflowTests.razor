    public async Task FluentOverflow_RefreshAsync_WithoutRuntimeDoesNothing()
    {
        var overflow = new FluentOverflow<string>(new LibraryConfiguration());
        await overflow.RefreshAsync();
        Assert.Empty(overflow.ItemsOverflow);
    }

    [Fact]
    public void FluentOverflow_NullItems_RendersChildContentOnce()
    {
        var cut = Render(@<FluentOverflow TItem="string"><span>Direct content</span></FluentOverflow>);
        Assert.Equal("Direct content", Assert.Single(cut.FindAll("fluent-overflow > span")).TextContent);
        Assert.Equal(0, cut.FindComponent<FluentOverflow<string>>().Instance.OverflowCount);
    }

    [Fact]
    public async Task FluentOverflow_DirectContent_ExposesAllOverflowItemsToTemplates()
    {
        IEnumerable<OverflowItem>? raisedItems = null;
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow" Selector=".managed"
                                         OnOverflowRaised="@(items => raisedItems = items)">
            <ChildContent>
                @foreach (var index in Enumerable.Range(0, 6))
                {
                    <span class="managed">Item @index</span>
                }
            </ChildContent>
            <MoreTemplate><output>@context.OverflowCount</output></MoreTemplate>
            <OverflowTemplate>
                @foreach (var item in context.ItemsOverflow)
                {
                    <div class="overflow-record">@item.Text</div>
                }
            </OverflowTemplate>
        </FluentOverflow>);

        Assert.Equal(6, cut.FindAll("fluent-overflow > span").Count);
        Assert.Null(cut.Find("fluent-overflow").GetAttribute("max-overflow-items"));
        Assert.Equal(".managed", cut.Find("fluent-overflow").GetAttribute("selector"));
        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow", OverflowCount = 4,
            Items = [
                new() { Id = "item2", Text = "Item 2", Index = 2 },
                new() { Id = "item3", Text = "Item 3", Index = 3 },
                new() { Id = "item4", Text = "Item 4", Index = 4 },
                new() { Id = "item5", Text = "Item 5", Index = 5 },
            ],
        });

        Assert.Equal("4", cut.Find("output").TextContent);
        Assert.Equal(new[] { "Item 2", "Item 3", "Item 4", "Item 5" }, cut.FindAll(".overflow-record").Select(element => element.TextContent));
        Assert.Equal(new[] { 2, 3, 4, 5 }, raisedItems!.Select(item => item.Index));

        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs { Id = "overflow", OverflowCount = -1 });
        Assert.Equal("0", cut.Find("output").TextContent);
        Assert.Empty(cut.FindAll(".overflow-record"));
    }

    [Fact]
    public async Task FluentOverflow_DirectContentRerender_PreservesOverflowState()
    {
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow">
            <ChildContent><span>Initial content</span></ChildContent>
            <MoreTemplate><FluentButton>+@context.OverflowCount</FluentButton></MoreTemplate>
            <OverflowTemplate>
                <FluentTooltip Anchor="@context.IdMoreButton" UseTooltipService="false">
                    @foreach (var item in context.ItemsOverflow)
                    {
                        <span class="overflow-record">@item.Text</span>
                    }
                </FluentTooltip>
            </OverflowTemplate>
        </FluentOverflow>);
        var host = cut.Find("fluent-overflow");
        var overflow = cut.FindComponent<FluentOverflow<string>>();

        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow",
            Items = [new() { Id = "second", Text = "Second", Index = 1 }],
            OverflowCount = 1,
        });

        Assert.Equal("+1", cut.Find("#overflow-more fluent-button").TextContent.Trim());
        Assert.Equal("Second", cut.Find(".overflow-record").TextContent);

        overflow.Render(parameters => parameters.Add(component => component.ChildContent,
            builder => builder.AddMarkupContent(0, "<span>Updated content</span>")));

        Assert.Equal("+1", cut.Find("#overflow-more fluent-button").TextContent.Trim());
        Assert.Equal("Second", cut.Find(".overflow-record").TextContent);
    }

