@using Microsoft.FluentUI.AspNetCore.Components.Tests.Extensions
@using Xunit
@inherits FluentUITestContext

@code {
    public FluentOverflowTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents();
    }

    [Fact]
    public void FluentOverflow_Renders_Direct_Children()
    {
        var cut = Render(@<div><FluentOverflow TItem="string" Id="overflow">
            <div>Item 1</div>
            <div>Item 2</div>
        </FluentOverflow></div>);

        Assert.Equal(3, cut.FindAll("fluent-overflow > *").Count);
        var overflow = cut.Find("fluent-overflow");
        Assert.Null(overflow.GetAttribute("max-overflow-items"));
        Assert.Null(overflow.GetAttribute("pre-overflow-count"));
    }

    [Theory]
    [InlineData(10, 10, 90)]
    [InlineData(0, 100, 0)]
    [InlineData(-1, 100, 0)]
    [InlineData(200, 100, 0)]
    public void FluentOverflow_MaxRenderedItems_LimitsTemplateInvocations(int limit, int rendered, int overflowCount)
    {
        var items = Enumerable.Range(0, 100).ToArray();
        var invocationCount = 0;
        OverflowContext<int>? templateContext = null;
        var cut = Render(@<FluentOverflow Items="@items" MaxRenderedItems="@limit" Id="overflow">
            <ItemTemplate Context="item">
                @{ invocationCount++; }
                <span>@item</span>
            </ItemTemplate>
            <OverflowTemplate Context="overflow">
                @{ templateContext = overflow; }
                <output>@overflow.OverflowCount</output>
            </OverflowTemplate>
        </FluentOverflow>);

        Assert.Equal(rendered, invocationCount);
        Assert.Equal(rendered, cut.FindAll("fluent-overflow > span").Count);
        Assert.Equal($"{overflowCount}", cut.Find("output").TextContent);
        Assert.Equal($"{overflowCount}", cut.Find("fluent-overflow").GetAttribute("pre-overflow-count"));
        Assert.Equal(items.Skip(rendered), templateContext!.Items);
        Assert.Null(cut.Find("fluent-overflow").GetAttribute("max-overflow-items"));
    }

    [Fact]
    public async Task FluentOverflow_MeasuredOverflow_ExposesAllSourceObjects()
    {
        var items = Enumerable.Range(0, 100).Select(index => new ResourceUrl($"Resource {index}")).ToArray();
        IEnumerable<OverflowItem>? raisedItems = null;
        OverflowContext<ResourceUrl>? templateContext = null;
        var cut = Render(@<FluentOverflow TItem="ResourceUrl" Id="overflow" Items="@items" MaxRenderedItems="10"
                                         OnOverflowRaised="@(values => raisedItems = values)">
            <ItemTemplate Context="url"><FluentBadge>@url.DisplayName</FluentBadge></ItemTemplate>
            <MoreTemplate Context="overflow"><span id="count">@overflow.OverflowCount</span></MoreTemplate>
            <OverflowTemplate Context="overflow">
                @{ templateContext = overflow; }
                <div id="overflow-items" data-anchor="@overflow.IdMoreButton">
                    @foreach (var url in overflow.Items)
                    {
                        <span>@url.DisplayName</span>
                    }
                </div>
            </OverflowTemplate>
        </FluentOverflow>);

        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow",
            OverflowCount = 95,
            Items = Enumerable.Range(5, 5).Select(index => new OverflowChangedItem { Index = index, Text = "Not the source text" }).ToArray(),
        });

        var overflow = cut.FindComponent<FluentOverflow<ResourceUrl>>().Instance;
        Assert.Equal(95, overflow.OverflowCount);
        Assert.Equal(items.Skip(5), templateContext!.Items);
        Assert.Same(items[5], templateContext.Items[0]);
        Assert.Equal(Enumerable.Range(5, 5), raisedItems!.Select(item => item.Index));
        Assert.Equal("95", cut.Find("#count").TextContent);
        Assert.Equal(95, cut.FindAll("#overflow-items > span").Count);
        Assert.Equal("overflow-more", cut.Find("#overflow-items").GetAttribute("data-anchor"));
        Assert.Equal(10, cut.FindAll("fluent-overflow > fluent-badge").Count);
    }

    [Fact]
    public async Task FluentOverflow_Resize_KeepsPreOverflowedItems()
    {
        var items = Enumerable.Range(0, 100).ToArray();
        var cut = Render(@<FluentOverflow Items="@items" MaxRenderedItems="10" Id="overflow"><ItemTemplate Context="item"><span>@item</span></ItemTemplate></FluentOverflow>);
        var host = cut.Find("fluent-overflow");
        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow", Items = [new() { Index = 8 }, new() { Index = 9 }], OverflowCount = 92,
        });
        Assert.Equal(items.Skip(8).Select(item => $"{item}"), cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));

        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs { Id = "overflow", Items = [], OverflowCount = 90 });

        Assert.Equal(items.Skip(10).Select(item => $"{item}"), cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));
        Assert.Equal(90, cut.FindAll("fluent-tooltip > div").Count);
    }

    [Fact]
    public async Task FluentOverflow_EventForAnotherComponent_IsIgnored()
    {
        var callbackCount = 0;
        var cut = Render(@<FluentOverflow TItem="string" Items="@(new[] { "Item" })" Id="overflow"
                                         OnOverflowRaised="@(() => callbackCount++)"><ItemTemplate Context="item"><span>@item</span></ItemTemplate></FluentOverflow>);

        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "other", Items = [new() { Index = 0 }], OverflowCount = 1,
        });

        Assert.Equal(0, callbackCount);
        Assert.Empty(cut.FindComponent<FluentOverflow<string>>().Instance.ItemsOverflow);
    }

    [Fact]
    public async Task FluentOverflow_SourceChanges_UpdatesOverflowAndLimit()
    {
        var items = new List<int> { 0, 1, 2, 3 };
        var limit = 2;
        var cut = Render(@<FluentOverflow Items="@items" MaxRenderedItems="@limit" Id="overflow"><ItemTemplate Context="item"><span>@item</span></ItemTemplate></FluentOverflow>);
        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow", Items = [new() { Index = 1 }], OverflowCount = 3,
        });

        items.Reverse();
        var overflow = cut.FindComponent<FluentOverflow<int>>();
        overflow.Render(parameters => parameters.Add(component => component.Items, items));
        Assert.Equal(new[] { "2", "1", "0" }, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));

        limit = 1;
        overflow.Render(parameters => parameters.Add(component => component.MaxRenderedItems, limit));
        Assert.Single(cut.FindAll("fluent-overflow > span"));
        Assert.Equal(new[] { "2", "1", "0" }, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));

        items.Clear();
        overflow.Render(parameters => parameters.Add(component => component.Items, items));
        Assert.Empty(cut.FindAll("fluent-overflow > span"));
        Assert.Empty(cut.FindAll("fluent-tooltip > div"));
    }

    [Fact]
    public async Task FluentOverflow_SwitchingToDirectContent_ClearsOverflowState()
    {
        var items = new[] { "First", "Second" };
        var cut = Render(@<FluentOverflow Items="@items" Id="overflow">
            <ChildContent><span>Direct content</span></ChildContent>
            <ItemTemplate Context="item"><span>@item</span></ItemTemplate>
        </FluentOverflow>);
        var host = cut.Find("fluent-overflow");
        var overflow = cut.FindComponent<FluentOverflow<string>>();

        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow",
            Items = [new() { Id = "second", Text = "Second", Index = 1 }],
            OverflowCount = 1,
        });

        overflow.Render(parameters => parameters.Add(component => component.Items, (IEnumerable<string>?)null));

        Assert.Equal("Direct content", Assert.Single(cut.FindAll("fluent-overflow > span")).TextContent);
        Assert.Empty(overflow.Instance.ItemsOverflow);
        Assert.Equal(0, overflow.Instance.OverflowCount);
        Assert.Empty(cut.FindAll("fluent-tooltip > div"));

        overflow.Render(parameters => parameters.Add(component => component.Items, items));
        Assert.Empty(cut.FindAll("fluent-tooltip > div"));
    }

    [Fact]
    public async Task FluentOverflow_InvalidAndDuplicateIndices_AreIgnored()
    {
        var items = new[] { "Same", "Same", "Last" };
        var cut = Render(@<FluentOverflow Items="@items" MaxRenderedItems="2" Id="overflow"><ItemTemplate Context="item"><span>@item</span></ItemTemplate></FluentOverflow>);
        await cut.Find("fluent-overflow").TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow", Items = [new() { Index = 1 }, new() { Index = 0 }, new() { Index = 1 }, new() { Index = -1 }, new() { Index = 50 }],
        });

        Assert.Equal(items, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));

        cut.FindComponent<FluentOverflow<string>>().Render(parameters => parameters.Add(component => component.Items, items));
        Assert.Equal(items, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));
    }

    [Fact]
    public void FluentOverflow_ItemText_FormatsDefaultTooltip()
    {
        var items = new[] { new ResourceUrl("First"), new ResourceUrl("Second") };
        var cut = Render(@<FluentOverflow Items="@items" MaxRenderedItems="1" ItemText="@(url => url.DisplayName)"
                         Orientation="Orientation.Vertical" VisibleOnLoad="false"><ItemTemplate Context="url"><span>@url.DisplayName</span></ItemTemplate></FluentOverflow>);

        Assert.Contains("Second", cut.Find("fluent-tooltip").TextContent);
        Assert.Equal("vertical", cut.Find("fluent-overflow").GetAttribute("orientation"));
        Assert.Equal("false", cut.Find("fluent-overflow").GetAttribute("visible-on-load"));
    }

    [Fact]
    public async Task FluentOverflow_RefreshAsync_PreservesState()
    {
        var cut = Render(@<FluentOverflow TItem="int" Items="@(Enumerable.Range(0, 5))" MaxRenderedItems="2" Id="overflow"><ItemTemplate Context="item"><span>@item</span></ItemTemplate></FluentOverflow>);
        var overflow = cut.FindComponent<FluentOverflow<int>>().Instance;
        await cut.InvokeAsync(() => overflow.OverflowRaisedAsync([new() { Index = 1 }]));
        await overflow.RefreshAsync();

        Assert.Equal(new[] { "1", "2", "3", "4" }, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));
        Assert.Contains(JSInterop.Invocations, invocation => invocation.Identifier == "Microsoft.FluentUI.Blazor.Components.Overflow.refreshOverflow");
    }

    [Fact]
    public async Task FluentOverflow_OverflowRaisedAsync_InvokesCallbackAndRendersDefaultTooltip()
    {
        IEnumerable<OverflowItem>? raisedItems = null;
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow"
                                         OnOverflowRaised="@(items => raisedItems = items)">
            <span>Direct content</span>
        </FluentOverflow>);
        OverflowItem[] overflowItems =
        [
            new() { Id = "item1", Text = "Item 1", Index = 1 },
            new() { Id = "item2", Text = "Item 2", Index = 2 },
        ];

        await cut.InvokeAsync(() => cut.FindComponent<FluentOverflow<string>>().Instance.OverflowRaisedAsync(overflowItems));

        Assert.Same(overflowItems, raisedItems);
        Assert.Equal(new[] { "Item 1", "Item 2" }, cut.FindAll("fluent-tooltip > div").Select(element => element.TextContent));
    }

