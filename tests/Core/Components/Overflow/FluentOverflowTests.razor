    [Fact]
    public void FluentOverflow_NullItemTemplate_DoesNotRenderItems()
    {
        var cut = Render(@<FluentOverflow TItem="string" Items="@(new[] { "Item" })" />);
        Assert.Empty(cut.FindAll("fluent-overflow > span"));
    }

    [Fact]
    public void FluentOverflow_DefaultMoreAction_InvokesCallbackForClickAndKeyboard()
    {
        var invocationCount = 0;
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow" OnMoreClick="@(() => invocationCount++)">
            <span>Item</span>
        </FluentOverflow>);
        var trigger = cut.Find("#overflow-more");

        Assert.Equal("button", trigger.GetAttribute("role"));
        Assert.Equal("0", trigger.GetAttribute("tabindex"));
        trigger.Click();
        trigger.KeyDown("Enter");
        trigger.KeyDown(" ");
        trigger.KeyDown("Escape");

        Assert.Equal(3, invocationCount);
    }

    [Fact]
    public void FluentOverflow_DefaultTooltipTrigger_IsFocusableWithoutButtonRole()
    {
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow"><span>Item</span></FluentOverflow>);
        var trigger = cut.Find("#overflow-more");

        Assert.Equal("0", trigger.GetAttribute("tabindex"));
        Assert.False(trigger.HasAttribute("role"));
    }

    [Fact]
    public void FluentOverflow_CustomMoreTemplate_DoesNotInvokeDefaultAction()
    {
        var invocationCount = 0;
        var cut = Render(@<FluentOverflow TItem="string" Id="overflow" OnMoreClick="@(() => invocationCount++)">
            <MoreTemplate><button>Custom</button></MoreTemplate>
        </FluentOverflow>);
        var trigger = cut.Find("#overflow-more");

        Assert.False(trigger.HasAttribute("role"));
        Assert.False(trigger.HasAttribute("tabindex"));
        trigger.KeyDown("Enter");
        Assert.Equal(0, invocationCount);
    }

    private sealed record ResourceUrl(string DisplayName);
}