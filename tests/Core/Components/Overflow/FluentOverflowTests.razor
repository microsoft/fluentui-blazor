@using System.Reflection
@using Microsoft.FluentUI.AspNetCore.Components.Tests.Extensions
@using Xunit
@using static Microsoft.FluentUI.AspNetCore.Components.FluentOverflow
@inherits FluentUITestContext

@code {
    public FluentOverflowTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents();
    }

    [Fact]
    public void FluentOverflow_Renders_Direct_Children()
    {
        var cut = Render(@<div><FluentOverflow Id="overflow">
            <div>Item 1</div>
            <div>Item 2</div>
        </FluentOverflow></div>);

        Assert.Single(cut.FindAll("fluent-overflow"));
        Assert.Equal(3, cut.FindAll("fluent-overflow > *").Count);
        cut.Verify();
    }

    [Fact]
    public void FluentOverflow_DefaultParameters_UseNewAttributesAndTriggerSlot()
    {
        var cut = Render(@<FluentOverflow Id="overflow" Selector=".managed" VisibleOnLoad="false">
            <span class="managed">Item</span>
        </FluentOverflow>);

        var host = cut.Find("fluent-overflow");
        Assert.Equal("0", host.GetAttribute("max-overflow-items"));
        Assert.Equal(".managed", host.GetAttribute("selector"));
        Assert.Equal("false", host.GetAttribute("visible-on-load"));
        Assert.False(cut.FindComponent<FluentOverflow>().Instance.VisibleOnLoad);
        Assert.DoesNotContain("visibility", host.GetAttribute("style") ?? string.Empty);
        Assert.False(host.HasAttribute("store-overflow-in-memory"));
        Assert.False(host.HasAttribute("selectors"));
        Assert.False(host.HasAttribute("max-rendered-items"));
        Assert.Equal("trigger", cut.Find("#overflow-more").GetAttribute("slot"));
    }

    [Fact]
    public async Task FluentOverflow_EmptyEvent_ClearsItemsAndTooltip()
    {
        var callbackCount = 0;
        var cut = Render(@<FluentOverflow Id="overflow" OnOverflowRaised="@(() => callbackCount++)">
            <span>Item</span>
        </FluentOverflow>);
        var host = cut.Find("fluent-overflow");

        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs
        {
            Id = "overflow",
            OverflowCount = 1,
            Items = [new() { Id = "item", Text = "Hidden item", Index = 0 }],
        });
        Assert.Contains("Hidden item", cut.Find("fluent-tooltip").TextContent);

        await host.TriggerEventAsync("onoverflowchange", new OverflowChangedEventArgs { Id = "overflow", Items = [] });

        var overflow = cut.FindComponent<FluentOverflow>().Instance;
        Assert.Empty(overflow.ItemsOverflow);
        Assert.Equal(0, overflow.OverflowCount);
        Assert.Equal(2, callbackCount);
        Assert.DoesNotContain("Hidden item", cut.Find("fluent-tooltip").TextContent);
    }

    [Fact]
    public void FluentOverflow_Respects_Orientation()
    {
        var cut = Render(@<div><FluentOverflow Orientation="Orientation.Vertical">
            <div>Item 1</div>
        </FluentOverflow></div>);

        var container = cut.Find("fluent-overflow");
        Assert.Equal("vertical", container.GetAttribute("orientation"));
    }

    [Fact]
    public void FluentOverflow_Renders_MaxOverflowItems_Attribute()
    {
        var cut = Render(@<div><FluentOverflow MaxOverflowItems="5">
            <div>Item 1</div>
        </FluentOverflow></div>);

        var container = cut.Find("fluent-overflow");
        Assert.Equal("5", container.GetAttribute("max-overflow-items"));
    }
    [Fact]
    public void FluentOverflow_Custom_MoreTemplate()
    {
        var cut = Render(@<div><FluentOverflow>
            <MoreTemplate>
                <p>Custom More</p>
            </MoreTemplate>
            <ChildContent>
                <div>Item 1</div>
            </ChildContent>
        </FluentOverflow></div>);

        var customButton = cut.Find("p");
        Assert.NotNull(customButton);
        Assert.Equal("Custom More", customButton.TextContent);
    }

    [Fact]
    public void FluentOverflow_Custom_OverflowTemplate()
    {
        var cut = Render(@<div><FluentOverflow>
            <OverflowTemplate>
                <FluentTooltip Anchor="id1">Custom Overflow Content</FluentTooltip>
            </OverflowTemplate>
            <ChildContent>
                <div>Item 1</div>
            </ChildContent>
        </FluentOverflow><FluentTooltipProvider /></div>);

        var tooltip = cut.Find("fluent-tooltip");
        Assert.NotNull(tooltip);
        Assert.Contains("Custom Overflow Content", tooltip.TextContent);
    }

    [Fact]
    public async Task FluentOverflow_Calls_OverflowRaisedAsync()
    {
        var overflowRaised = false;
        var cut = Render(@<div><FluentOverflow Id="overflow" OnOverflowRaised="@(() => overflowRaised = true)">
            <div id="item1">Item 1</div>
            <div id="item2">Item 2</div>
        </FluentOverflow></div>);

        var overflow = cut.FindComponent<FluentOverflow>();
        await overflow.Instance.OverflowRaisedAsync([
            new OverflowItem { Id = "item1", Text = "Item 1", Index = 0 }
        ]);

        Assert.True(overflowRaised);
        Assert.Single(overflow.Instance.ItemsOverflow);
        Assert.Equal("Item 1", overflow.Instance.ItemsOverflow.First().Text);
    }

    [Fact]
    public void FluentOverflow_Renders_Default_Tooltip_When_OverflowTemplate_Is_Null()
    {
        var cut = Render(@<div><FluentOverflow>
            <div>Item 1</div>
        </FluentOverflow></div>);

        var tooltip = cut.Find("fluent-tooltip");
        Assert.NotNull(tooltip);
        Assert.Equal("below-start", tooltip.GetAttribute("positioning"));
    }

    [Fact]
    public async Task FluentOverflow_RefreshAsync_PreservesStateWithoutSnapshotRead()
    {
        var cut = Render(@<div><FluentOverflow Id="overflow">
            <div id="item1">Item 1</div>
            <div id="item2">Item 2</div>
        </FluentOverflow></div>);

        JSInterop.SetupVoid("Microsoft.FluentUI.Blazor.Components.Overflow.refreshOverflow", args => (string?)args.Arguments[0] == "overflow")
            .SetVoidResult();

        var overflow = cut.FindComponent<FluentOverflow>();
        await overflow.Instance.OverflowRaisedAsync([new() { Id = "item2", Text = "Item 2", Index = 1 }]);
        var previousInvocationCount = JSInterop.Invocations.Count;
        await overflow.Instance.RefreshAsync();

        Assert.Equal(1, overflow.Instance.OverflowCount);
        Assert.Equal("item2", Assert.Single(overflow.Instance.ItemsOverflow).Id);
        var invocation = Assert.Single(JSInterop.Invocations.Skip(previousInvocationCount));
        Assert.Equal("Microsoft.FluentUI.Blazor.Components.Overflow.refreshOverflow", invocation.Identifier);
        Assert.Equal("overflow", Assert.Single(invocation.Arguments));
    }

    [Fact]
    public async Task FluentOverflow_RefreshAsync_NoJsRuntime_DoesNothing()
    {
        var overflow = new FluentOverflow(new LibraryConfiguration());

        await overflow.RefreshAsync();

        Assert.Equal(0, overflow.OverflowCount);
        Assert.Empty(overflow.ItemsOverflow);
    }

    [Fact]
    public async Task FluentOverflow_OnOverflowChangedAsync_UpdatesStateAndRaisesCallback()
    {
        var overflowRaised = false;
        var cut = Render(@<div><FluentOverflow Id="overflow" OnOverflowRaised="@(() => overflowRaised = true)">
            <div id="item1">Item 1</div>
            <div id="item2">Item 2</div>
        </FluentOverflow></div>);

        var overflow = cut.FindComponent<FluentOverflow>();
        var method = GetPrivateMethod("OnOverflowChangedAsync", typeof(OverflowChangedEventArgs));
        var args = new OverflowChangedEventArgs
        {
            Id = "overflow",
            OverflowCount = 6,
            Items =
            [
                new OverflowChangedItem { Id = "item1", Text = "Item 1", Index = 0 },
                new OverflowChangedItem { Id = "item2", Text = "Item 2", Index = 1 }
            ]
        };

        await ((Task)method.Invoke(overflow.Instance, [args])!);

        Assert.True(overflowRaised);
        Assert.Equal(6, overflow.Instance.OverflowCount);
        var items = overflow.Instance.ItemsOverflow.ToList();
        Assert.Equal(2, items.Count);
        Assert.Equal("item1", items[0].Id);
        Assert.Equal(1, items[1].Index);
    }

    [Fact]
    public async Task FluentOverflow_OnOverflowChangedAsync_IgnoresDifferentComponentId()
    {
        var overflowRaised = false;
        var cut = Render(@<div><FluentOverflow Id="overflow" OnOverflowRaised="@(() => overflowRaised = true)">
            <div id="item1">Item 1</div>
        </FluentOverflow></div>);

        var overflow = cut.FindComponent<FluentOverflow>();
        await overflow.Instance.OverflowRaisedAsync([
            new OverflowItem { Id = "item1", Text = "Item 1", Index = 0 }
        ]);
        overflowRaised = false;

        var method = GetPrivateMethod("OnOverflowChangedAsync", typeof(OverflowChangedEventArgs));
        var args = new OverflowChangedEventArgs
        {
            Id = "other-overflow",
            OverflowCount = 0,
            Items =
            [
                new OverflowChangedItem { Id = "item1", Text = "Item 1", Index = 0 }
            ]
        };

        await ((Task)method.Invoke(overflow.Instance, [args])!);

        Assert.False(overflowRaised);
        Assert.Equal(1, overflow.Instance.OverflowCount);
        Assert.Single(overflow.Instance.ItemsOverflow);
    }

    [Fact]
    public void FluentOverflow_SetOverflowItems_OverflowChangedItemOverload_SetsExpectedState()
    {
        var cut = Render(@<div><FluentOverflow Id="overflow">
            <div id="item1">Item 1</div>
        </FluentOverflow></div>);
        var overflow = cut.FindComponent<FluentOverflow>();
        var method = GetPrivateMethod("SetOverflowItems", typeof(IEnumerable<OverflowChangedItem>), typeof(int));

        method.Invoke(overflow.Instance, new object?[]
        {
            new OverflowChangedItem[]
            {
                new() { Id = "item1", Text = "Item 1", Index = 2 },
                new() { Id = "item2", Text = "Item 2", Index = 3 }
            },
            6
        });

        Assert.Equal(6, overflow.Instance.OverflowCount);
        var items = overflow.Instance.ItemsOverflow.ToList();
        Assert.Equal(2, items.Count);
        Assert.Equal("item1", items[0].Id);
        Assert.Equal(2, items[0].Index);

        method.Invoke(overflow.Instance, new object?[] { null, -1 });
        Assert.Equal(0, overflow.Instance.OverflowCount);
        Assert.Empty(overflow.Instance.ItemsOverflow);
    }

    private static MethodInfo GetPrivateMethod(string name, params Type[] parameterTypes) =>
        typeof(FluentOverflow).GetMethod(name, BindingFlags.Instance | BindingFlags.NonPublic, null, parameterTypes, null)
        ?? throw new InvalidOperationException($"Private method '{name}' not found.");
}
