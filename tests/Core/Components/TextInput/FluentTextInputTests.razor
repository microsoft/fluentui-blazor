    [Fact]
    public void FluentInputText_OnChange()
    {
        // Arrange
        using var context = new IdentifierContext(i => "myId");
        var value = "init";
        var cut = Render(@<FluentTextInput @bind-Value="@value" />);

        // Act
        cut.Find("fluent-text-input").Change("new value");

        // Assert
        Assert.Equal("new value", value);
        cut.Find("fluent-text-input")
           .MarkupMatches("<fluent-text-input id=\"myId\" slot=\"input\" appearance=\"outline\" value=\"new value\" />");
    }

    [Theory]
    [InlineData(false, 0, "init", "init")] // No Immediate
    [InlineData(true, 0, "new value", "new value")] // With Immediate and Delay = 0 ms
    public async Task FluentInputText_OnImmediate(bool immediate, int immediateDelay, string expectedImmediateValue, string
expectedDelayedValue)
    {
        await Task.CompletedTask;

        // Arrange
        using var context = new IdentifierContext(i => "myId");
        var value = "init";
        var cut = Render(@<FluentTextInput @bind-Value="@value"                 Immediate="@immediate"                 ImmediateDelay="@immediateDelay" />);

        // Act
        cut.Find("fluent-text-input").TriggerEvent("ontextimmediate", new ChangeEventArgs() { Value = "new value" });

        // Assert: Immediate
        Assert.Equal(expectedImmediateValue, value);
        cut.Find("fluent-text-input")
           .MarkupMatches($"<fluent-text-input id=\"myId\" slot=\"input\" appearance=\"outline\" value=\"{expectedImmediateValue}\" />");

        // Assert: After a small delay
        Assert.Equal(expectedDelayedValue, value);
        cut.Find("fluent-text-input")
           .MarkupMatches($"<fluent-text-input id=\"myId\" slot=\"input\" appearance=\"outline\" value=\"{expectedDelayedValue}\" />");
    }

    [Fact]
    public async Task FluentInputText_OnImmediate_OutOfOrderCompletion_LastValueWins()
    {
        // Arrange
        var value = "init";
        var cut = Render(@<SlowFluentTextInput @bind-Value="@value"                     Immediate="true"                     ImmediateDelay="0"                     ProcessingDelayMs="30" />);
        var element = cut.Find("fluent-text-input");

        // Act: the older "first" keystroke starts processing (artificially slow)...
        var firstTask = element.TriggerEventAsync("ontextimmediate", new ChangeEventArgs() { Value = "first" });

        // ...while the newer "second" keystroke arrives and queues up right behind it.
        var secondTask = element.TriggerEventAsync("ontextimmediate", new ChangeEventArgs() { Value = "second" });

        await firstTask;
        await secondTask;

        // Assert: even though "first" only finishes processing after "second" was already
        // queued, the newer value must win over the older, now-superseded one.
        Assert.Equal("second", value);
    }

    [Fact]
    public void FluentInputText_Immediate_WhileFocused_ValueAttributeStaysFrozen()
    {
        // Arrange
        var value = "init";
        var cut = Render(@<FluentTextInput @bind-Value="@value"                 Immediate="true"                 ImmediateDelay="0" />);
        var element = cut.Find("fluent-text-input");
        element.TriggerEvent("onfocusin", new FocusEventArgs());

        // Act: simulate the user typing while the field still has focus
        element.TriggerEvent("ontextimmediate", new ChangeEventArgs() { Value = "typed" });

        // Assert: the confirmed value updates, but the rendered native `value` stays frozen
        // at what was displayed when focus started - it must never reset mid-typing.
        Assert.Equal("typed", value);
        Assert.Equal("init", cut.Find("fluent-text-input").GetAttribute("value"));
    }

    [Fact]
    public void FluentInputText_Immediate_OnFocusOut_UnfreezesAndResyncsValueAttribute()
    {
        // Arrange: focus and type while focused, so the rendered value freezes at "init"
        var value = "init";
        var cut = Render(@<FluentTextInput @bind-Value="@value"                 Immediate="true"                 ImmediateDelay="0" />);
        var element = cut.Find("fluent-text-input");
        element.TriggerEvent("onfocusin", new FocusEventArgs());
        element.TriggerEvent("ontextimmediate", new ChangeEventArgs() { Value = "typed" });

        // Act: the field loses focus
        element.TriggerEvent("onfocusout", new FocusEventArgs());

        // Assert: the rendered value resyncs to the confirmed text now that typing has stopped
        Assert.Equal("typed", value);
        Assert.Equal("typed", cut.Find("fluent-text-input").GetAttribute("value"));
    }

    [Fact]
    public void FluentInputText_NotImmediate_WhileFocused_ValueAttributeReflectsExternalUpdates()
    {
        // Arrange
        var cut = Render(@<FluentTextInput Value="init" />);
        var textInput = cut.FindComponent<FluentTextInput>();
        var element = cut.Find("fluent-text-input");
        element.TriggerEvent("onfocusin", new FocusEventArgs());

        // Act: a legitimate external/programmatic update to Value happens while still focused
        textInput.Render(parameters => parameters.Add(p => p.Value, "external"));

        // Assert: outside Immediate mode there's no per-keystroke round trip to protect against,
        // so the freeze must not apply - the DOM reflects the update right away, not after blur.
        Assert.Equal("external", cut.Find("fluent-text-input").GetAttribute("value"));
    }

