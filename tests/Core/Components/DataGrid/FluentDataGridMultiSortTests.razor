    [Fact]
    public async Task FluentDataGrid_MultiSort_ColumnHeaders_WithMoreThanOneSortLevel_OnlyMarkThePrimaryColumnWithAriaSort()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMultiSortGrid(out grid);

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Descending);

        var headers = cut.FindAll("th");

        // Assert
        Assert.Equal("ascending", headers[0].GetAttribute("aria-sort"));
        Assert.Equal("none", headers[1].GetAttribute("aria-sort"));

        // Both sorted columns are marked for styling, the unsorted one is not.
        Assert.Equal("asc", headers[0].GetAttribute("col-sort"));
        Assert.Equal("desc", headers[1].GetAttribute("col-sort"));
        Assert.False(headers[2].HasAttribute("col-sort"));
    }

    [Fact]
    public async Task FluentDataGrid_MultiSort_ColumnHeaders_WithMoreThanOneSortLevel_DescribeTheirSortLevel()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMultiSortGrid(out grid);

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Descending);

        var descriptions = cut.FindAll("[col-sort-description]");
        var sortButtons = cut.FindAll("[col-sort-button]");

        // Assert
        Assert.Equal(2, descriptions.Count);
        Assert.Equal("Sorted ascending, sort level 1 of 2", descriptions[0].TextContent);
        Assert.Equal("Sorted descending, sort level 2 of 2", descriptions[1].TextContent);

        // The description is what makes the level available to a screen reader, so it has to be referenced.
        Assert.Equal(descriptions[0].Id, sortButtons[0].GetAttribute("aria-describedby"));
        Assert.Equal(descriptions[1].Id, sortButtons[1].GetAttribute("aria-describedby"));

        // The level is also shown visually, but hidden from assistive technology to avoid saying it twice.
        var levels = cut.FindAll("[col-sort-level]");
        Assert.Equal(["1", "2"], levels.Select(level => level.TextContent));
        Assert.All(levels, level => Assert.Equal("true", level.GetAttribute("aria-hidden")));
    }

