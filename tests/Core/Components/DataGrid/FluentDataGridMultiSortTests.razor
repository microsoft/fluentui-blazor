@using Microsoft.AspNetCore.Components.Web
@using Microsoft.FluentUI.AspNetCore.Components.DataGrid.Infrastructure
@using Xunit
@inherits FluentUITestContext

@code {
    public FluentDataGridMultiSortTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;

        Services.AddFluentUIComponents();
        Services.AddScoped<IKeyCodeService>(factory => new KeyCodeService());
    }

    [Fact]
    public async Task FluentDataGrid_MultiSort_AddSortByColumnAsync_WithMultipleMode_SortsByEveryLevelInOrder()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMultiSortGrid(out grid);

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Ascending);

        // Assert
        Assert.Equal(2, grid.SortColumns.Count);
        Assert.Equal("Department", grid.SortColumns[0].Column.Title);
        Assert.Equal("Name", grid.SortColumns[1].Column.Title);
        Assert.Equal(["IT/Alice", "IT/Bob", "Sales/Alice", "Sales/Carol"], GetRenderedItems(cut));
    }

