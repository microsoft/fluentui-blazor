    [Fact]
    public async Task FluentDataGrid_MultiSort_AddSortByColumnAsync_WhenTheColumnsSortCannotBeAppended_SortsByThatColumnAlone()
    {
        // Arrange: a ColumnKeyGridSort with a sort function but no then-sort function cannot be a secondary level.
        var nameSort = new ColumnKeyGridSort<Employee>(
            "name",
            (queryable, ascending) => ascending ? queryable.OrderBy(x => x.Name) : queryable.OrderByDescending(x => x.Name));

        FluentDataGrid<Employee>? grid = default!;
        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@grid" Items="@GetEmployees()" SortMode="DataGridSortMode.Multiple">
                <PropertyColumn Property="@(x => x.Department)" Sortable="true" />
                <TemplateColumn Title="Name" Sortable="true" SortBy="@nameSort">@context.Name</TemplateColumn>
            </FluentDataGrid>
        );

        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);

        // Act
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Ascending);

        // Assert
        Assert.False(grid.CanAddToSort(grid._columns[1]));
        Assert.Single(grid.SortColumns);
        Assert.Equal("Name", grid.SortColumns[0].Column.Title);
    }

    [Fact]
    public async Task FluentDataGrid_MultiSort_ItemsProviderRequest_ReportsEverySortLevel()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        GridItemsProviderRequest<Employee>? lastRequest = null;

        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@grid" Items="@GetEmployees()" SortMode="DataGridSortMode.Multiple"
                             RefreshItems="@(request => { lastRequest = request; return Task.CompletedTask; })">
                <PropertyColumn Property="@(x => x.Department)" Sortable="true" />
                <PropertyColumn Property="@(x => x.Name)" Sortable="true" />
            </FluentDataGrid>
        );

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Descending);

        // Assert
        Assert.NotNull(lastRequest);
        Assert.Equal(["Department", "Name"], lastRequest!.Value.SortColumns.Select(level => level.Column.Title));
        Assert.Equal([true, false], lastRequest!.Value.SortColumns.Select(level => level.Ascending));

        var properties = lastRequest!.Value.GetSortByProperties().ToList();
        Assert.Equal(["Department", "Name"], properties.Select(property => property.PropertyName));
        Assert.Equal([DataGridSortDirection.Ascending, DataGridSortDirection.Descending], properties.Select(property => property.Direction));
    }

