    [Theory]
    [InlineData(DataGridSortMode.Single, DataGridCellAlignment.Start)]
    [InlineData(DataGridSortMode.Single, DataGridCellAlignment.Center)]
    [InlineData(DataGridSortMode.Single, DataGridCellAlignment.End)]
    [InlineData(DataGridSortMode.Multiple, DataGridCellAlignment.Start)]
    [InlineData(DataGridSortMode.Multiple, DataGridCellAlignment.Center)]
    [InlineData(DataGridSortMode.Multiple, DataGridCellAlignment.End)]
    public void FluentDataGrid_ColumnHeader_PutsThePopupButtonWhereTheAlignmentDoes(DataGridSortMode sortMode, DataGridCellAlignment align)
    {
        // Arrange: ColumnOptions gives the header a popup button in single sort mode as well, so that both modes
        // render the same two buttons and their order can be compared.
        // Act
        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" Items="@GetEmployees()" SortMode="@sortMode">
                <PropertyColumn Property="@(x => x.Name)" Sortable="true" Align="@align">
                    <ColumnOptions><span>Options</span></ColumnOptions>
                </PropertyColumn>
            </FluentDataGrid>
        );

        var buttons = cut.FindAll("th")[0].QuerySelectorAll("[col-sort-button], [col-options-button]");

        // Assert: multi-column sorting adds actions to the header popup, but does not move the button that opens
        // it. The button keeps the place the column's alignment gives it - before the sort button for a start or
        // center aligned header, after it for an end aligned one - so single sort mode keeps its markup and its
        // keyboard order.
        Assert.Equal(2, buttons.Length);

        var popupButtonComesFirst = align != DataGridCellAlignment.End;
        Assert.Equal(popupButtonComesFirst, buttons[0].HasAttribute("col-options-button"));
        Assert.Equal(popupButtonComesFirst, buttons[1].HasAttribute("col-sort-button"));
    }

