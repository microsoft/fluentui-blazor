    [Fact]
    public async Task FluentDataGrid_MultiSort_HeaderMenu_WithMultipleMode_OffersTheSortActions()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMenuGrid(out grid);

        // Assert: nothing is sorted yet, so there is only a direction to pick.
        Assert.Equal(["Sort ascending", "Sort descending"], GetMenuItemLabels(cut, grid, column: 2));

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);

        // Assert: another column can now join the sort.
        Assert.Equal(["Sort ascending", "Sort descending", "Add to sort"], GetMenuItemLabels(cut, grid, column: 2));

        // Act: menu items are activated with Enter, since their OnClick runs on the web component's change event,
        // which bUnit cannot raise.
        ActivateMenuItem(cut, grid, column: 2, label: "Add to sort");

        // Assert
