    private IRenderedComponent<FluentDataGrid<Employee>> RenderMultiSortGrid(
        out FluentDataGrid<Employee> grid,
        DataGridSortMode sortMode = DataGridSortMode.Multiple,
        bool defaultSortColumn = false,
        bool saveStateInUrl = false)
    {
        FluentDataGrid<Employee>? reference = default!;

        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@reference" Items="@GetEmployees()" SortMode="@sortMode" SaveStateInUrl="@saveStateInUrl">
                <PropertyColumn Property="@(x => x.Department)" Sortable="true" IsDefaultSortColumn="@defaultSortColumn" InitialSortDirection="DataGridSortDirection.Ascending" />
                <PropertyColumn Property="@(x => x.Name)" Sortable="true" />
                <PropertyColumn Property="@(x => x.Level)" Sortable="true" />
            </FluentDataGrid>
        );

        grid = reference!;
        return cut;
    }

    private IRenderedComponent<FluentDataGrid<Employee>> RenderMenuGrid(out FluentDataGrid<Employee> grid, bool defaultSortColumn = false)
    {
        FluentDataGrid<Employee>? reference = default!;

        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@reference" Items="@GetEmployees()" SortMode="DataGridSortMode.Multiple" HeaderCellAsButtonWithMenu="true">
                <PropertyColumn Property="@(x => x.Department)" Sortable="true" IsDefaultSortColumn="@defaultSortColumn" InitialSortDirection="DataGridSortDirection.Ascending" />
                <PropertyColumn Property="@(x => x.Name)" Sortable="true" />
            </FluentDataGrid>
        );

        grid = reference!;
        return cut;
    }

    private static void ActivateMenuItem(IRenderedComponent<FluentDataGrid<Employee>> cut, FluentDataGrid<Employee> grid, int column, string label)
        => FindMenuItem(cut, grid, column, label).KeyDown(new KeyboardEventArgs { Key = "Enter" });

    private static IEnumerable<IElement> GetHeaderPopupMenuItems(IRenderedComponent<FluentDataGrid<Employee>> cut)
        => cut.Find("[col-header-ui]").QuerySelectorAll("fluent-menu-item");

    private static List<string> GetMenuItemLabels(IRenderedComponent<FluentDataGrid<Employee>> cut, FluentDataGrid<Employee> grid, int column)
        => cut.Find($"#{grid.Id}-col-{column}-menu")
            .QuerySelectorAll("fluent-menu-item")
            .Select(item => item.TextContent.Trim())
            .ToList();

    private static IElement FindMenuItem(IRenderedComponent<FluentDataGrid<Employee>> cut, FluentDataGrid<Employee> grid, int column, string label)
        => cut.Find($"#{grid.Id}-col-{column}-menu")
            .QuerySelectorAll("fluent-menu-item")
            .First(item => string.Equals(item.TextContent.Trim(), label, StringComparison.Ordinal));

    private static List<string> GetRenderedItems(IRenderedComponent<FluentDataGrid<Employee>> cut)
        => cut.FindComponent<FluentDataGridRow<Employee>>().Instance.InternalGridContext.Items
            .Select(employee => $"{employee.Department}/{employee.Name}")
            .ToList();

    private static IQueryable<Employee> GetEmployees() =>
        new[]
        {
            new Employee("Sales", "Carol", 2),
            new Employee("IT", "Alice", 3),
            new Employee("Sales", "Alice", 1),
            new Employee("IT", "Bob", 2),
        }.AsQueryable();

    private record Employee(string Department, string Name, int Level);
