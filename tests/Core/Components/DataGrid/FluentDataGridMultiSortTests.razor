    [Fact]
    public async Task FluentDataGrid_MultiSort_SortState_WhenTheSortIsCleared_RemovesOrderByFromTheQueryString()
    {
        // Arrange
        var navigationManager = Services.GetRequiredService<NavigationManager>();
        FluentDataGrid<Employee>? grid = default!;

        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@grid" Items="@GetEmployees()" SortMode="DataGridSortMode.Multiple" SaveStateInUrl="true">
