    [Fact]
    public async Task FluentDataGrid_MultiSort_HeaderMenu_AfterASortAction_PutsFocusBackOnTheHeaderButton()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMenuGrid(out grid);

        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);

        var headerButton = cut.FindComponents<FluentButton>()
            .Select(button => button.Instance)
            .Where(button => button.AdditionalAttributes?.ContainsKey("col-sort-button") == true)
            .ElementAt(1);

        // Act
        ActivateMenuItem(cut, grid, column: 2, label: "Add to sort");

        // Assert
        var focused = JSInterop.Invocations["Blazor._internal.domWrapper.focus"]
            .Select(invocation => invocation.Arguments[0])
            .OfType<ElementReference>()
            .Last();

        Assert.Equal(headerButton.Element.Id, focused.Id);
    }

    [Fact]
    public void FluentDataGrid_MultiSort_ColumnHeaderPopup_AfterASortAction_PutsFocusBackOnTheButtonThatOpenedIt()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMultiSortGrid(out grid);

        cut.FindAll("[col-options-button]")[1].Click();

        var optionsButton = cut.FindComponents<FluentButton>()
            .Select(button => button.Instance)
            .Where(button => button.AdditionalAttributes?.ContainsKey("col-options-button") == true)
            .ElementAt(1);

        // Act
        GetHeaderPopupMenuItems(cut)
            .First(item => string.Equals(item.TextContent.Trim(), "Sort ascending", StringComparison.Ordinal))
            .KeyDown(new KeyboardEventArgs { Key = "Enter" });

        // Assert: the popup is gone, so focus has to go back to its button or it falls off the header entirely.
        Assert.Empty(cut.FindAll("[col-header-ui]"));

        var focused = JSInterop.Invocations["Blazor._internal.domWrapper.focus"]
            .Select(invocation => invocation.Arguments[0])
            .OfType<ElementReference>()
            .Last();

        Assert.Equal(optionsButton.Element.Id, focused.Id);
    }

    [Fact]
    public async Task FluentDataGrid_MultiSort_SortStatus_AnnouncesTheSortOrderInALiveRegion()
    {
        // Arrange
        FluentDataGrid<Employee>? grid = default!;
        var cut = RenderMultiSortGrid(out grid);

        // Assert: the live region is rendered up front, so screen readers pick up later changes to it.
        var status = cut.Find("[sort-status]");
        Assert.Equal("status", status.GetAttribute("role"));
        Assert.Equal("polite", status.GetAttribute("aria-live"));
        Assert.Empty(status.TextContent);

        // Act
        await grid.SortByColumnAsync("Department", DataGridSortDirection.Ascending);
        await grid.AddSortByColumnAsync("Name", DataGridSortDirection.Descending);

        // Assert
        Assert.Equal("Sorted by Department ascending, then by Name descending", cut.Find("[sort-status]").TextContent);

        // Act
        await grid.ClearSortAsync();

        // Assert
        Assert.Equal("Sorting cleared", cut.Find("[sort-status]").TextContent);
    }

