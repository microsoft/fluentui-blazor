    [Fact]
    public async Task FluentDataGrid_MultiSort_DeclaredSort_WhenAColumnIsRemoved_DropsThatColumnsLevel()
    {
        // Arrange: two columns declare a sort, so the sort ResetSortAsync restores has two levels.
        var showLevel = true;
        FluentDataGrid<Employee>? grid = default!;

        var cut = Render<FluentDataGrid<Employee>>(
            @<FluentDataGrid TGridItem="Employee" @ref="@grid" Items="@GetEmployees()" SortMode="DataGridSortMode.Multiple">
                <PropertyColumn Property="@(x => x.Department)" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="DataGridSortDirection.Ascending" />
                @if (showLevel)
                {
                    <PropertyColumn Property="@(x => x.Level)" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="DataGridSortDirection.Descending" />
                }
            </FluentDataGrid>
        );

        Assert.Equal(["Department", "Level"], grid.SortColumns.Select(level => level.Column.Title));

        // Act: the Level column goes away, and the grid is asked for the sort its columns declare.
        showLevel = false;
        cut.Render();
        await grid.ResetSortAsync();

        // Assert: a column the grid no longer holds must not come back through the declared sort, where it would
        // reach OnSortChanged and the provider request.
        Assert.Equal(["Department"], grid.SortColumns.Select(level => level.Column.Title));
        Assert.All(grid.SortColumns, level => Assert.Contains(level.Column, grid._columns));
    }

