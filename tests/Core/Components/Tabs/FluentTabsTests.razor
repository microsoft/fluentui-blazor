    [Fact]
    public async Task FluentTabs_RemoveTabAsync_UpdatesSelection()
    {
        // Arrange
        var cut = Render(@<FluentTabs ActiveTabId="tab2">
            <FluentTab Id="tab1" Header="Chat" />
            <FluentTab Id="tab2" Header="Files" />
        </FluentTabs>);
        var tabs = cut.FindComponent<FluentTabs>().Instance;
        var tab2 = cut.FindComponents<FluentTab>()[1].Instance;

        // Act
        // Removing tab2 (which is active) should move selection to tab1
        await tabs.RemoveTabAsync(tab2);

        // Assert
        Assert.Equal("tab1", tabs.ActiveTabId);
        Assert.Equal("tab1", tabs.ActiveTab?.Id);
    }

    [Fact]
