    [Theory]
    [InlineData("MyTabsId", "tab1", "tab1")]            // Normal case
    [InlineData("INVALID_TABS_ID", "tab1", "tab2")]     // Main TabsID is unknown => no change (stay on tab2)
    [InlineData("MyTabsId", "INVALID_TAB", "tab2")]     // Try to go to an unknow Tab => no change (stay on tab2)
    public async Task FluentTabs_ActiveTabId(string eventTabsId, string eventActiveId, string? expectedActiveId)
    {
        string? activeTabId = "tab2";

        // Arrange
        var cut = Render(@<FluentTabs Id="MyTabsId" @bind-ActiveTabId="@activeTabId">
            <FluentTab Id="tab1" Header="Chat">
                Here's some information about the chat.
            </FluentTab>

            <FluentTab Id="tab2" Header="Files">
                Here's the list of all files.
            </FluentTab>
        </FluentTabs>);

        // Act
        await cut.FindComponent<FluentTabs>().Instance.TabChangeHandlerAsync(new()
        {
            Id = eventTabsId + "-tablist",
            ActiveId = eventActiveId,
        });

        // Assert
        Assert.Equal(expectedActiveId, activeTabId);
    }

    [Fact]
    public async Task FluentTabs_UserSelection_DoesNotRewriteActiveId()
    {
        string? activeTabId = "tab1";

        // Arrange
        var cut = Render(@<FluentTabs Id="MyTabsId" @bind-ActiveTabId="@activeTabId">
            <FluentTab Id="tab1" Header="Chat" />
            <FluentTab Id="tab2" Header="Files" />
        </FluentTabs>);
        var tabList = cut.Find("fluent-tablist");

        // Act
        await tabList.TriggerEventAsync("ontabchange", new TabChangeEventArgs
        {
            Id = "MyTabsId-tablist",
            ActiveId = "tab2",
        });

        // Assert: the bound value follows the client selection, but the server
        // does not write the `activeid` attribute back (the web component
        // already displays the selected tab).
        Assert.Equal("tab2", activeTabId);
        Assert.Equal("tab1", tabList.GetAttribute("activeid"));
    }

    [Fact]
    public async Task FluentTabs_ParameterSelection_ReappliesPreviousValueAfterUserSelection()
    {
        string? activeTabId = "tab1";

        // Arrange
        var cut = Render(@<FluentTabs Id="MyTabsId" @bind-ActiveTabId="@activeTabId">
            <FluentTab Id="tab1" Header="Chat" />
            <FluentTab Id="tab2" Header="Files" />
        </FluentTabs>);
        var tabs = cut.FindComponent<FluentTabs>();
        var tabList = cut.Find("fluent-tablist");
        tabs.Render(parameters => parameters.Add(component => component.ActiveTabId, "tab2"));
        tabList.SetAttribute("activeid", "tab1");
        await tabList.TriggerEventAsync("ontabchange", new TabChangeEventArgs
        {
            Id = "MyTabsId-tablist",
            ActiveId = "tab1",
        });

        // Act
        tabs.Render(parameters => parameters.Add(component => component.ActiveTabId, "tab2"));

        // Assert
        Assert.Equal("tab2", tabList.GetAttribute("activeid"));
    }

    [Fact]
    public async Task FluentTabs_RejectedClientEvent_DoesNotSuppressParameterSelection()
    {
        string? activeTabId = "tab1";
        var tab2Disabled = true;

        // Arrange: tab1 active, tab2 disabled
        var cut = Render(@<FluentTabs Id="MyTabsId" @bind-ActiveTabId="@activeTabId">
            <FluentTab Id="tab1" Header="Chat" />
            <FluentTab Id="tab2" Header="Files" Disabled="@tab2Disabled" />
        </FluentTabs>);
        var tabs = cut.FindComponent<FluentTabs>();
        var tabList = cut.Find("fluent-tablist");

        // Act 1: client event targeting the disabled tab2 is rejected...
        await tabList.TriggerEventAsync("ontabchange", new TabChangeEventArgs
        {
            Id = "MyTabsId-tablist",
            ActiveId = "tab2",
        });

        // ...and must not pollute the client-selection marker
        Assert.Equal("tab1", tabs.Instance.ActiveTabId);
        Assert.Equal("tab1", tabList.GetAttribute("activeid"));

        // Act 2: enable tab2, then drive the selection via parameter
        tab2Disabled = false;
        cut.Render();
        tabs.Render(parameters => parameters.Add(component => component.ActiveTabId, "tab2"));

        // Assert: the parameter update is applied, not suppressed by the stale marker
        Assert.Equal("tab2", tabs.Instance.ActiveTabId);
        Assert.Equal("tab2", tabList.GetAttribute("activeid"));
    }

