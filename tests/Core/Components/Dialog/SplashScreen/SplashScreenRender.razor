<FluentDialogBody>
    <span class="splash-message">@SplashScreen.Message</span>
    <span class="custom-message">@CustomMessage</span>
</FluentDialogBody>

@code {
    [Parameter]
    public SplashScreenContent SplashScreen { get; set; } = default!;

    [Parameter]
    public string? CustomMessage { get; set; }
}
