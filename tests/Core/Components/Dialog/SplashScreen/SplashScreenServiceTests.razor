@using Xunit
@inherits FluentUITestContext
@code
{
    public SplashScreenServiceTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents(options => options.UseGlobalOverlay = false);

        DialogService = Services.GetRequiredService<IDialogService>();
        DialogProvider = Render<FluentDialogProvider>();
    }

    /// <summary>
    /// Gets the dialog service.
    /// </summary>
    public IDialogService DialogService { get; }

    /// <summary>
    /// Gets the dialog provider.
    /// </summary>
    public IRenderedComponent<FluentDialogProvider> DialogProvider { get; }

    [Fact]
    public async Task ShowSplashScreenAsync_WithTypedOptions_PassesOptionsToComponent()
    {
        // Arrange
        var message = new MarkupString("<strong>Loading</strong>");

        var options = new SplashScreenOptions
        {
            LoadingText = "Loading...",
            Logo = "logo.svg",
            Message = message,
            SubTitle = "Fluent UI",
            Title = "Blazor"
        };

        // Act
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options);

        // Assert
        var componentOptions = DialogProvider.FindComponent<SplashScreenRender>().Instance.SplashScreen;
        Assert.Same(options, splash.Options);
        Assert.Same(options, componentOptions);
        Assert.Same(options, Assert.Single(options.Parameters).Value);
        Assert.Equal("Loading...", componentOptions.LoadingText);
        Assert.Equal("logo.svg", componentOptions.Logo);
        Assert.Equal(message, componentOptions.Message);
        Assert.Equal("Fluent UI", componentOptions.SubTitle);
        Assert.Equal("Blazor", componentOptions.Title);
        Assert.Equal("Loading", DialogProvider.Find(".splash-message strong").TextContent);
    }

    [Fact]
    public async Task ShowSplashScreenAsync_WithOptions_ReturnsInstanceWithoutWaiting()
    {
        // Act
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options =>
        {
            options.Message = new MarkupString("Loading...");
        });

        // Assert
        Assert.NotNull(splash);
        Assert.IsType<SplashScreenInstance>(splash);
        Assert.False(splash.Result.IsCompleted);
        Assert.True(splash.Options.PreventDismissOnEscape);
        DialogProvider.WaitForAssertion(() => Assert.Contains("Loading...", DialogProvider.Find("fluent-dialog").TextContent));
    }

    [Fact]
    public async Task ShowSplashScreenAsync_NoOptions_RendersDialog()
    {
        // Act
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>();

        // Assert
        Assert.NotNull(splash);
        DialogProvider.WaitForAssertion(() => Assert.Single(DialogProvider.FindAll("fluent-dialog")));
        Assert.Same(splash.Options, DialogProvider.FindComponent<SplashScreenRender>().Instance.SplashScreen);
    }

    [Fact]
    public async Task ShowSplashScreenAsync_PreventDismissOnEscapeSetToFalse_KeepsValue()
    {
        // Act
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(new SplashScreenOptions { PreventDismissOnEscape = false });

        // Assert
        Assert.False(splash.Options.PreventDismissOnEscape);
    }

    [Fact]
    public async Task UpdateAsync_NewMessage_RerendersContent()
    {
        // Arrange
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options =>
        {
            options.Message = new MarkupString("Loading...");
        });

        // Act
        await splash.UpdateAsync(options => options.Message = new MarkupString("Hello World"));

        // Assert
        DialogProvider.WaitForAssertion(() => Assert.Contains("Hello World", DialogProvider.Find("fluent-dialog").TextContent));
        Assert.DoesNotContain("Loading...", DialogProvider.Find("fluent-dialog").TextContent);
    }

    [Fact]
    public async Task UpdateAsync_ReplacedParameters_PreservesSplashScreenAndUpdatesCustomParameters()
    {
        // Arrange
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options =>
        {
            options.Message = new MarkupString("Loading...");
            options.Parameters[nameof(SplashScreenRender.CustomMessage)] = "Initial custom message";
        });
        Assert.Equal("Initial custom message", DialogProvider.Find(".custom-message").TextContent);

        // Act
        await splash.UpdateAsync(options =>
        {
            options.Message = new MarkupString("Ready");
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(SplashScreenRender.CustomMessage)] = "Updated custom message"
            };
        });

        // Assert
        DialogProvider.WaitForAssertion(() =>
        {
            Assert.Equal("Ready", DialogProvider.Find(".splash-message").TextContent);
            Assert.Equal("Updated custom message", DialogProvider.Find(".custom-message").TextContent);
        });
        Assert.Same(splash.Options, DialogProvider.FindComponent<SplashScreenRender>().Instance.SplashScreen);
    }

    [Fact]
    public async Task CloseAsync_SplashScreen_RemovesDialogAndCompletesResult()
    {
        // Arrange
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>();

        // Act
        await splash.CloseAsync();
        var result = await splash.Result;

        // Assert
        Assert.False(result.Cancelled);
        DialogProvider.WaitForAssertion(() => Assert.Empty(DialogProvider.FindAll("fluent-dialog")));
    }

    [Fact]
    public async Task UpdateAsync_ClosedDialog_DoesNotUpdateOptions()
    {
        // Arrange
        var options = new SplashScreenOptions
        {
            Message = new MarkupString("Loading...")
        };
        var splash = await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options);
        await splash.CloseAsync();

        // Act
        await splash.UpdateAsync(options => options.Message = new MarkupString("Hello World"));

        // Assert
        Assert.Equal("Loading...", options.Message?.Value);
    }

    [Fact]
    public async Task ShowSplashScreenAsync_NotAComponent_ThrowsArgumentException()
    {
        // Act & Assert
        await Assert.ThrowsAsync<ArgumentException>(() => DialogService.ShowSplashScreenAsync(typeof(string), new SplashScreenOptions()));
    }

    [Fact]
    public async Task ShowSplashScreenAsync_DuplicateId_ThrowsInvalidOperationException()
    {
        // Arrange
        await DialogService.ShowSplashScreenAsync<SplashScreenRender>(options => options.Id = "my-splash");

        // Act & Assert
        await Assert.ThrowsAsync<InvalidOperationException>(() => DialogService.ShowSplashScreenAsync<SplashScreenRender>(options => options.Id = "my-splash"));
    }

    [Fact]
    public async Task ShowSplashScreenAsync_ProviderNotAvailable_ThrowsException()
    {
        // Arrange
        DialogProvider.Instance.UpdateId(null);

        // Act & Assert
        await Assert.ThrowsAsync<FluentServiceProviderException<FluentDialogProvider>>(() => DialogService.ShowSplashScreenAsync<SplashScreenRender>());
    }
}
