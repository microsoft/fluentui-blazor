@namespace Microsoft.FluentUI.AspNetCore.Components.Tests.Components.Toast.Templates

<div class="custom-toast" data-instance-id="@(ToastInstance?.Id)">
    Custom: @Text
</div>

@code {
    [CascadingParameter]
    public IToastInstance? ToastInstance { get; set; }

    [Parameter]
    public string? Text { get; set; }
}
