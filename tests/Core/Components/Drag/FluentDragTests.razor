	[Fact]
	public async Task FluentDragContainer_Touch_Flow_Invokes_Handlers()
	{
		// Arrange
		FluentDragEventArgs<int>? start = null, end = null, enter = null, over = null, leave = null, drop = null;
		FluentDragEventArgs<int>? zoneEnter = null, zoneOver = null, zoneLeave = null, zoneDrop = null;

		var cut = Render(@<FluentDragContainer TItem="int"
											   OnDragStart="(e) => start = e"
											   OnDragEnd="(e) => end = e"
											   OnDragEnter="(e) => enter = e"
											   OnDragOver="(e) => over = e"
											   OnDragLeave="(e) => leave = e"
											   OnDropEnd="(e) => drop = e">
			<FluentDropZone Id="src" Draggable="true" TItem="int" Item="1">Source</FluentDropZone>
			<FluentDropZone Id="dst" Droppable="true" TItem="int" Item="2"
							OnDragEnter="(e) => zoneEnter = e"
							OnDragOver="(e) => zoneOver = e"
							OnDragLeave="(e) => zoneLeave = e"
							OnDropEnd="(e) => zoneDrop = e">Target</FluentDropZone>
		</FluentDragContainer>);

		var container = cut.FindComponent<FluentDragContainer<int>>().Instance;

		// Act & Assert: start
		await cut.InvokeAsync(() => container.TouchDragStartAsync("src"));
		Assert.NotNull(start);
		Assert.Equal(1, start!.Source.Item);

		// enter
		await cut.InvokeAsync(() => container.TouchDragEnterAsync("src", "dst"));
		Assert.Equal(2, enter!.Target.Item);
		Assert.Equal(1, enter.Source.Item);
		Assert.Equal(2, zoneEnter!.Target.Item);
		Assert.True(cut.Find("#dst").HasAttribute("dragged-over"));

		// over
		await cut.InvokeAsync(() => container.TouchDragOverAsync("src", "dst"));
		Assert.Equal(2, over!.Target.Item);
		Assert.Equal(2, zoneOver!.Target.Item);

		// leave
		await cut.InvokeAsync(() => container.TouchDragLeaveAsync("src", "dst"));
		Assert.Equal(2, leave!.Target.Item);
		Assert.Equal(2, zoneLeave!.Target.Item);
		Assert.False(cut.Find("#dst").HasAttribute("dragged-over"));

		// enter again then drop
		await cut.InvokeAsync(() => container.TouchDragEnterAsync("src", "dst"));
		await cut.InvokeAsync(() => container.TouchDropAsync("src", "dst"));
		Assert.Equal(1, drop!.Source.Item);
		Assert.Equal(2, drop.Target.Item);
		Assert.Equal(2, zoneDrop!.Target.Item);
		Assert.False(cut.Find("#dst").HasAttribute("dragged-over"));

		// end
		await cut.InvokeAsync(() => container.TouchDragEndAsync("src"));
		Assert.Equal(1, end!.Source.Item);
		Assert.Null(container.StartedZone);
	}

