	[Fact]
	public void FluentDropZone_Refresh_Rerenders_Component()
	{
		// Arrange
		var cut = Render(@<FluentDragContainer TItem="int">
			<FluentDropZone Id="r" TItem="int" Item="1">A</FluentDropZone>
		</FluentDragContainer>);
		var zone = cut.FindComponent<FluentDropZone<int>>();
		var renderCount = zone.RenderCount;

