    [Fact]
    public void FluentSplitButton_DisabledTwice_ClosesMenuOnce()
    {
        // Arrange
        var cut = Render<FluentSplitButton>(@<FluentSplitButton>My button</FluentSplitButton>);

        // Act
        cut.Render(parameters => parameters.Add(p => p.Disabled, true));
        cut.Render(parameters => parameters.Add(p => p.Disabled, true));
        cut.Render(parameters => parameters.Add(p => p.Disabled, false));
        cut.Render(parameters => parameters.Add(p => p.Disabled, true));

        // Assert
        Assert.Equal(2, JSInterop.Invocations["Microsoft.FluentUI.Blazor.Components.Menu.CloseMenu"].Count);
    }

    [Fact]
    public void FluentSplitButton_Disabled_CanBeReEnabled()
    {
        // Arrange
        var clicked = false;
        var cut = Render<FluentSplitButton>(@<FluentSplitButton Disabled="true" OnClick="@(e => { clicked = true; })">My button</FluentSplitButton>);

        // Act
        cut.Render(parameters => parameters.Add(p => p.Disabled, false));
        cut.Find("fluent-button").Click();

        // Assert
        Assert.True(clicked);
        Assert.False(cut.Find("fluent-button").HasAttribute("disabled"));
        Assert.False(cut.Find("fluent-menu-button").HasAttribute("disabled"));
    }

    private static string GetDisabledState(AngleSharp.Dom.IElement element)
    {
        var disabled = element.HasAttribute("disabled");
        var focusable = element.HasAttribute("disabled-focusable");

        Assert.False(disabled && focusable, "An inner button must not be both disabled and disabled-focusable.");

        return disabled ? "disabled" : focusable ? "disabled-focusable" : string.Empty;
    }

