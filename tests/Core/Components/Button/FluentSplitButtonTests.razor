    // Expected state of each inner button: "" = enabled, "disabled" or "disabled-focusable".
    [Theory]
    [InlineData(false, false, null, null, "", "")]
    [InlineData(true, false, null, null, "disabled", "disabled")]
    [InlineData(false, true, null, null, "disabled-focusable", "disabled-focusable")]
    [InlineData(true, true, null, null, "disabled-focusable", "disabled-focusable")]
    [InlineData(false, false, true, null, "disabled", "")]
    [InlineData(false, false, null, true, "", "disabled")]
    [InlineData(false, false, true, true, "disabled", "disabled")]
    [InlineData(false, false, false, false, "", "")]
    [InlineData(true, false, false, null, "", "disabled")]
    [InlineData(true, false, null, false, "disabled", "")]
    [InlineData(true, false, false, false, "", "")]
    [InlineData(false, true, false, null, "", "disabled-focusable")]
    [InlineData(false, true, null, false, "disabled-focusable", "")]
    [InlineData(false, true, true, null, "disabled-focusable", "disabled-focusable")]
    public void FluentSplitButton_DisabledState(bool disabled, bool disabledFocusable, bool? primaryActionDisabled, bool? menuButtonDisabled, string expectedPrimary, string expectedMenu)
    {
        // Arrange && Act
        var cut = Render(@<FluentSplitButton Disabled="@disabled"
                                             DisabledFocusable="@disabledFocusable"
                                             PrimaryActionDisabled="@primaryActionDisabled"
                                             MenuButtonDisabled="@menuButtonDisabled">My button</FluentSplitButton>);

        // Assert
        Assert.Equal(expectedPrimary, GetDisabledState(cut.Find("fluent-button")));
        Assert.Equal(expectedMenu, GetDisabledState(cut.Find("fluent-menu-button")));
    }

