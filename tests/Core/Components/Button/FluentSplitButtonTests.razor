    // Changing the parameters after the first render: is the open menu closed?
    [Theory]
    [InlineData(nameof(FluentSplitButton.Disabled), true)]
    [InlineData(nameof(FluentSplitButton.DisabledFocusable), true)]
    [InlineData(nameof(FluentSplitButton.MenuButtonDisabled), true)]
    [InlineData(nameof(FluentSplitButton.PrimaryActionDisabled), false)]
    public void FluentSplitButton_BecomesDisabled_ClosesMenu(string parameter, bool expectClose)
    {
        // Arrange
        var cut = Render<FluentSplitButton>(@<FluentSplitButton Id="my-split">My button</FluentSplitButton>);

        // Act
        cut.Render(parameters =>
        {
            switch (parameter)
            {
                case nameof(FluentSplitButton.Disabled): parameters.Add(p => p.Disabled, true); break;
                case nameof(FluentSplitButton.DisabledFocusable): parameters.Add(p => p.DisabledFocusable, true); break;
                case nameof(FluentSplitButton.MenuButtonDisabled): parameters.Add(p => p.MenuButtonDisabled, true); break;
                case nameof(FluentSplitButton.PrimaryActionDisabled): parameters.Add(p => p.PrimaryActionDisabled, true); break;
            }
        });

        // Assert
        var invocations = JSInterop.Invocations["Microsoft.FluentUI.Blazor.Components.Menu.CloseMenu"];
        if (expectClose)
        {
            var invocation = Assert.Single(invocations);
            Assert.Equal("my-split", invocation.Arguments[0]);
        }
        else
        {
            Assert.Empty(invocations);
        }
    }

