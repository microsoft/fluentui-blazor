    // Which callbacks are raised: the primary OnClick and the menu's OnMenuClick.
    // OnMenuCheckedChanged is always raised, so the checked state stays in sync with the menu.
    [Theory]
    [InlineData(false, false, null, null, true, true)]
    [InlineData(true, false, null, null, false, false)]
    [InlineData(false, true, null, null, false, false)]
    [InlineData(true, true, null, null, false, false)]
    [InlineData(false, false, true, null, false, true)]
    [InlineData(false, false, null, true, true, false)]
    [InlineData(true, false, false, null, true, false)]
    [InlineData(true, false, null, false, false, true)]
    [InlineData(false, true, false, null, true, false)]
    [InlineData(false, true, null, false, false, true)]
    public void FluentSplitButton_DisabledState_Callbacks(bool disabled, bool disabledFocusable, bool? primaryActionDisabled, bool? menuButtonDisabled, bool expectClick, bool expectMenu)
    {
        // Arrange
        var clicked = false;
        var menuClicked = false;
        var menuChecked = false;
        var cut = Render(@<FluentSplitButton Disabled="@disabled"
                                             DisabledFocusable="@disabledFocusable"
                                             PrimaryActionDisabled="@primaryActionDisabled"
                                             MenuButtonDisabled="@menuButtonDisabled"
                                             OnClick="@(e => { clicked = true; })"
                                             OnMenuClick="@(e => { menuClicked = true; })"
                                             OnMenuCheckedChanged="@(e => { menuChecked = true; })"
                                             Label="My button">
                <FluentMenuList>
                    <FluentMenuItem Id="item1">Item 1</FluentMenuItem>
                    <FluentMenuItem Id="item2" Role="MenuItemRole.Checkbox">Item 2</FluentMenuItem>
                </FluentMenuList>
            </FluentSplitButton>);

        // Act
        cut.Find("fluent-button").Click();
        cut.Find("fluent-menu-item#item1").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item1" });
        cut.Find("fluent-menu-item#item2").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item2", Checked = true });

        // Assert
        Assert.Equal(expectClick, clicked);
        Assert.Equal(expectMenu, menuClicked);
        Assert.True(menuChecked);
    }

    [Fact]
    public void FluentSplitButton_DisabledMenuItem_RendersDisabledItemOnly()
    {
        // Arrange && Act
        var cut = Render(@<FluentSplitButton Label="My button">
                <FluentMenuList>
                    <FluentMenuItem Id="item1">Item 1</FluentMenuItem>
                    <FluentMenuItem Id="item2" Disabled="true">Item 2</FluentMenuItem>
                </FluentMenuList>
            </FluentSplitButton>);

        // Assert
        Assert.False(cut.Find("fluent-menu-item#item1").HasAttribute("disabled"));
        Assert.True(cut.Find("fluent-menu-item#item2").HasAttribute("disabled"));
        Assert.Equal(string.Empty, GetDisabledState(cut.Find("fluent-button")));
        Assert.Equal(string.Empty, GetDisabledState(cut.Find("fluent-menu-button")));
    }

    [Fact]
    public void FluentSplitButton_PrimaryActionDisabled_WithDisabledMenuItem()
    {
        // Arrange
        var clicked = false;
        var menuClicks = new List<string?>();
        var cut = Render(@<FluentSplitButton PrimaryActionDisabled="true"
                                             OnClick="@(e => { clicked = true; })"
                                             OnMenuClick="@(e => menuClicks.Add(e.Id))"
                                             Label="My button">
                <FluentMenuList>
                    <FluentMenuItem Id="item1">Item 1</FluentMenuItem>
                    <FluentMenuItem Id="item2" Disabled="true">Item 2</FluentMenuItem>
                </FluentMenuList>
            </FluentSplitButton>);

        // Act
        cut.Find("fluent-button").Click();
        cut.Find("fluent-menu-item#item1").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item1" });
        cut.Find("fluent-menu-item#item2").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item2" });

        // Assert
        Assert.Equal("disabled", GetDisabledState(cut.Find("fluent-button")));
        Assert.Equal(string.Empty, GetDisabledState(cut.Find("fluent-menu-button")));
        Assert.False(clicked);
        Assert.Equal(["item1"], menuClicks);
    }

    // The menu unchecks the other radio items itself, including the disabled ones (and while the menu button is disabled).
    [Theory]
    [InlineData(false)]
    [InlineData(true)]
    public void FluentSplitButton_DisabledRadioMenuItem_UncheckedByMenu_CheckedChangedRaised(bool menuButtonDisabled)
    {
        // Arrange
        bool? item2Checked = true;
        var checkedChanges = new List<(string? Id, bool? Checked)>();
        var cut = Render(@<FluentSplitButton MenuButtonDisabled="@menuButtonDisabled" OnMenuCheckedChanged="@(e => checkedChanges.Add((e.Id, e.Checked)))" Label="My button">
                <FluentMenuList>
                    <FluentMenuItem Id="item1" Role="MenuItemRole.Radio">Item 1</FluentMenuItem>
                    <FluentMenuItem Id="item2" Role="MenuItemRole.Radio" Disabled="true" Checked="@item2Checked" CheckedChanged="@(v => item2Checked = v)">Item 2</FluentMenuItem>
                </FluentMenuList>
            </FluentSplitButton>);

        // Act
        cut.Find("fluent-menu-item#item2").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item2", Checked = false });
        cut.Find("fluent-menu-item#item1").TriggerEvent("onmenuitemchange", new MenuItemEventArgs { Id = "item1", Checked = true });

        // Assert
        Assert.False(item2Checked);
        Assert.Equal([("item2", (bool?)false), ("item1", (bool?)true)], checkedChanges);
    }

    [Fact]
    public void FluentSplitButton_BecomesDisabled_CloseMenuFailureIgnored()
    {
        // Arrange: the circuit is disconnected when the menu is closed
        JSInterop.SetupVoid("Microsoft.FluentUI.Blazor.Components.Menu.CloseMenu", _ => true).SetException(new JSDisconnectedException("Disconnected"));
        var cut = Render<FluentSplitButton>(@<FluentSplitButton>My button</FluentSplitButton>);

        // Act
        cut.Render(parameters => parameters.Add(p => p.Disabled, true));

        // Assert
        Assert.Single(JSInterop.Invocations["Microsoft.FluentUI.Blazor.Components.Menu.CloseMenu"]);
        Assert.Equal("disabled", GetDisabledState(cut.Find("fluent-menu-button")));
    }

