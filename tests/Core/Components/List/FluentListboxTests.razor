    [Fact]
    public void FluentListbox_NotifyValidationFieldChanged_CoversBindingExpressions()
    {
        var model = new ListboxValidationModel();
        var editContext = new EditContext(model);
        var list = new TestFluentListbox<string, string>();
        var changedFields = new List<FieldIdentifier>();
        editContext.OnFieldChanged += (_, args) => changedFields.Add(args.FieldIdentifier);
        list.AttachEditContext(editContext);

        list.ConfigureValidationExpressions(false, () => model.Items, null, null);
        list.InvokeNotifyValidationFieldChanged();
        Assert.Equal(new FieldIdentifier(model, nameof(ListboxValidationModel.Items)), Assert.Single(changedFields));

        changedFields.Clear();
        list.ConfigureValidationExpressions(true, null, () => model.SelectedItems, null);
        list.InvokeNotifyValidationFieldChanged();
        Assert.Equal(new FieldIdentifier(model, nameof(ListboxValidationModel.SelectedItems)), Assert.Single(changedFields));

        changedFields.Clear();
        list.ConfigureValidationExpressions(true, null, null, () => model.Value!);
        list.InvokeNotifyValidationFieldChanged();
        Assert.Equal(new FieldIdentifier(model, nameof(ListboxValidationModel.Value)), Assert.Single(changedFields));

        changedFields.Clear();
        list.ConfigureValidationExpressions(false, null, null, () => model.Value!);
        list.InvokeNotifyValidationFieldChanged();
        Assert.Equal(new FieldIdentifier(model, nameof(ListboxValidationModel.Value)), Assert.Single(changedFields));
    }

