@using Xunit;
@inherits FluentUITestContext

@code
{
    public FluentTreeMultipleTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents();
    }

    // Data source
    private readonly TreeViewItem[] Items =
    {
        new TreeViewItem("id1", "Item 1",
        [
            new TreeViewItem("id11", "Item 1.1"),
            new TreeViewItem("id12", "Item 1.2"),
            new TreeViewItem("id13", "Item 1.3"),
        ]),
        new TreeViewItem("id2", "Item 2",
        [
            new TreeViewItem("id21", "Item 2.1"),
            new TreeViewItem("id22", "Item 2.2"),
            new TreeViewItem("id23", "Item 2.3"),
        ]),
    };

    [Fact]
    public void FluentTreeMultiple_Default()
    {
        // Arrange && Act
        var cut = Render(@<FluentTreeView Items="@Items" SelectionMode="@TreeSelectionMode.Multiple" />);

        // Assert
        cut.Verify();
        Assert.NotEmpty(cut.FindComponents<FluentCheckbox>());
        Assert.All(cut.FindComponents<FluentCheckbox>(), checkbox =>
        {
            Assert.True(checkbox.Instance.ThreeState);
            Assert.False(checkbox.Instance.CheckState);
        });
    }

    [Fact]
    public void FluentTreeMultiple_SelectedItems_Add()
    {
        var selectedItems = Items.Where(i => i.Id == "id2").Cast<ITreeViewItem>();

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items" SelectionMode="@TreeSelectionMode.Multiple" @bind-SelectedItems="@selectedItems" />);

        // Before updates
        var checkedItems = cut.FindAll("fluent-tree-item:has(fluent-checkbox[checked='true'])");
        Assert.Single(selectedItems);
        Assert.Single(checkedItems);
        Assert.Equal("id2", checkedItems.First().GetAttribute("id"));

        // Act
        var checkbox = cut.FindComponents<FluentTreeItem>().Where(i => i.Instance.Id == "id1").First().Find("fluent-checkbox");
        checkbox.Change(new ChangeEventArgs());

        // After updates
        Assert.Equal(2, selectedItems.Count());
        Assert.Equal("id2", selectedItems.ElementAt(0).Id);
        Assert.Equal("id1", selectedItems.ElementAt(1).Id);
    }

    [Fact]
    public void FluentTreeMultiple_SelectedItems_Remove()
    {
        var selectedItems = Items.Where(i => i.Id == "id2").Cast<ITreeViewItem>();

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items" SelectionMode="@TreeSelectionMode.Multiple" @bind-SelectedItems="@selectedItems" />);

        // Act
        var checkbox = cut.FindComponents<FluentTreeItem>().Where(i => i.Instance.Id == "id2").First().Find("fluent-checkbox");
        checkbox.Change(new ChangeEventArgs());

        // Assert
        Assert.Empty(selectedItems);
    }

    [Theory]
    [InlineData(true)]
    [InlineData(false)]
    public async Task FluentTreeMultiple_ExplicitState_UpdatesSelection(bool state)
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.Multiple"
                        @bind-SelectedItems="@selectedItems" />);
        var item = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Instance;

        // Act
        await item.OnCheckChangedHandlerAsync(state);

        // Assert
        Assert.Equal(state ? ["id1"] : [], selectedItems!.Select(selected => selected.Id));
    }

    [Fact]
    public async Task FluentTreeMultiple_ToggleState_AddsAndRemovesSelection()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.Multiple"
                        @bind-SelectedItems="@selectedItems" />);
        var item = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Instance;

        // Act
        await item.OnCheckChangedHandlerAsync();
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.Multiple"
                        @bind-SelectedItems="@selectedItems" />);
        item = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Instance;
        await item.OnCheckChangedHandlerAsync();

        // Assert
        Assert.Empty(selectedItems!);
    }

    [Fact]
    public void FluentTreeMultiple_SelectingParent_DoesNotSelectDescendants()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.Multiple"
                        @bind-SelectedItems="@selectedItems" />);

        // Act
        var checkbox = cut.Find("fluent-tree-item#id1 > fluent-field fluent-checkbox");
        checkbox.Change(new ChangeEventArgs());

        // Assert
        Assert.Equal(["id1"], selectedItems!.Select(item => item.Id));
    }

    [Fact]
    public void FluentTreeMultipleRecursive_SelectingParent_SelectsDescendants()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);

        // Act
        var checkbox = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Find("fluent-checkbox");
        checkbox.Change(new ChangeEventArgs());

        // Assert
        Assert.Equal(["id1", "id11", "id12", "id13"], selectedItems!.Select(item => item.Id));
    }

    [Fact]
    public async Task FluentTreeMultipleRecursive_CheckedParent_DeselectsDescendants()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);

        var checkbox = cut.Find("fluent-tree-item#id1 > fluent-field fluent-checkbox");
        checkbox.Change(new ChangeEventArgs());
        Assert.Equal(["id1", "id11", "id12", "id13"], selectedItems!.Select(item => item.Id));

        // Act
        var checkboxComponent = cut.FindComponents<FluentCheckbox>()
            .Single(component => component.Instance.Id == checkbox.GetAttribute("id"));
        await checkboxComponent.InvokeAsync(() => checkboxComponent.Instance.CheckStateChanged.InvokeAsync(false));

        // Assert
        Assert.Empty(selectedItems!);
    }

    [Fact]
    public void FluentTreeMultipleRecursive_ChildSelection_UpdatesParentState()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [Items[0].Items!.First()];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);

        // Assert
        var parentCheckbox = cut.Find("fluent-tree-item#id1 > fluent-field fluent-checkbox");
        Assert.True(parentCheckbox.HasAttribute("indeterminate"));
        Assert.False(parentCheckbox.HasAttribute("checked"));
        Assert.DoesNotContain(selectedItems!, item => item.Id == "id1");
    }

    [Fact]
    public void FluentTreeMultipleRecursive_SelectedBranchWithUnselectedDescendants_UpdatesAncestors()
    {
        var items = new[]
        {
            new TreeViewItem("root", "Root",
            [
                new TreeViewItem("branch", "Branch",
                [
                    new TreeViewItem("leaf1", "Leaf 1"),
                    new TreeViewItem("leaf2", "Leaf 2"),
                ]),
            ]),
        };
        IEnumerable<ITreeViewItem>? selectedItems = [items[0].Items!.First()];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        SelectedItems="@selectedItems" />);

        // Assert
        Assert.True(cut.Find("fluent-tree-item#root > fluent-field fluent-checkbox").HasAttribute("indeterminate"));
        Assert.True(cut.Find("fluent-tree-item#branch > fluent-field fluent-checkbox").HasAttribute("indeterminate"));
    }

    [Fact]
    public async Task FluentTreeMultipleRecursive_SelectingNestedBranch_SynchronizesAllAncestors()
    {
        var items = new[]
        {
            new TreeViewItem("root", "Root",
            [
                new TreeViewItem("branch", "Branch",
                [
                    new TreeViewItem("leaf1", "Leaf 1"),
                    new TreeViewItem("leaf2", "Leaf 2"),
                ]),
            ]),
        };
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        var branch = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "branch").Instance;

        // Act
        await branch.OnCheckChangedHandlerAsync(true);

        // Assert
        Assert.Equal(["branch", "leaf1", "leaf2", "root"], selectedItems!.Select(item => item.Id));
    }

    [Fact]
    public async Task FluentTreeMultipleRecursive_DeselectingNestedLeaf_RemovesIncompleteAncestors()
    {
        var items = new[]
        {
            new TreeViewItem("root", "Root",
            [
                new TreeViewItem("branch", "Branch",
                [
                    new TreeViewItem("leaf1", "Leaf 1"),
                    new TreeViewItem("leaf2", "Leaf 2"),
                ]),
            ]),
        };
        IEnumerable<ITreeViewItem>? selectedItems =
        [
            items[0],
            items[0].Items!.First(),
            items[0].Items!.First().Items!.First(),
            items[0].Items!.First().Items!.ElementAt(1),
        ];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        var leaf = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "leaf1").Instance;

        // Act
        await leaf.OnCheckChangedHandlerAsync(false);

        // Assert
        Assert.Equal(["leaf2"], selectedItems!.Select(item => item.Id));
    }

    [Fact]
    public void FluentTreeMultipleRecursive_HiddenSelection_DoesNotRenderCheckbox()
    {
        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        MultipleSelectionVisibility="@(item => item.Id == "id1" ? TreeSelectionVisibility.Hidden : TreeSelectionVisibility.Visible)" />);

        // Assert
        Assert.Equal(7, cut.FindComponents<FluentCheckbox>().Count);
    }

    [Fact]
    public void FluentTreeMultiple_ItemTemplate_RendersCustomContent()
    {
        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items" SelectionMode="@TreeSelectionMode.Multiple">
            <ItemTemplate>
                <strong>@context.Text</strong>
            </ItemTemplate>
        </FluentTreeView>);

        // Assert
        Assert.Equal("Item 1", cut.Find("fluent-tree-item#id1 strong").TextContent);
    }

    [Fact]
    public void FluentTreeMultipleRecursive_IndeterminateParent_DeselectsThenSelectsDescendants()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [Items[0].Items!.First()];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);

        var parentCheckbox = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Find("fluent-checkbox");
        Assert.True(parentCheckbox.HasAttribute("indeterminate"));

        // Act: indeterminate -> deselected.
        parentCheckbox = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Find("fluent-checkbox");
        parentCheckbox.Change(new ChangeEventArgs());

        // Assert
        Assert.Empty(selectedItems!);
    }

    [Fact]
    public async Task FluentTreeMultipleRecursive_ChildToggle_RendersIndeterminateParent()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);

        var parentItem = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Instance;
        var childItem = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id11").Instance;

        // Select the parent and all descendants.
        await parentItem.OnCheckChangedHandlerAsync(true);
        Assert.Equal(["id1", "id11", "id12", "id13"], selectedItems!.Select(item => item.Id));

        // Clear one child.
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        childItem = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id11").Instance;
        await childItem.OnCheckChangedHandlerAsync(false);

        // Assert
        Assert.Equal(["id12", "id13"], selectedItems!.Select(item => item.Id));
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        SelectedItems="@selectedItems" />);
        var parentCheckbox = cut.Find("fluent-tree-item#id1 > fluent-field fluent-checkbox");
        Assert.True(parentCheckbox.HasAttribute("indeterminate"));
        Assert.False(parentCheckbox.HasAttribute("checked"));
    }

    [Fact]
    public void FluentTreeMultipleRecursive_LeafRechecked_DoesNotRenderCheckedIndeterminateParent()
    {
        IEnumerable<ITreeViewItem>? selectedItems = [];

        // Arrange
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        var leaf = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id11").Find("fluent-checkbox");

        // Select the leaf.
        leaf.Change(new ChangeEventArgs());

        // Deselect through the parent.
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        var parent = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Find("fluent-checkbox");
        parent.Change(new ChangeEventArgs());

        // Select the leaf again.
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        @bind-SelectedItems="@selectedItems" />);
        leaf = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id11").Find("fluent-checkbox");
        leaf.Change(new ChangeEventArgs());
        cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.MultipleRecursive"
                        SelectedItems="@selectedItems" />);

        // Assert
        parent = cut.FindComponents<FluentTreeItem>().First(i => i.Instance.Id == "id1").Find("fluent-checkbox");
        Assert.True(parent.HasAttribute("indeterminate"));
        Assert.False(parent.HasAttribute("checked"));
    }

    [Fact]
    public async Task TaskFluentTreeMultiple_SelectedItems_WhenOwnerTreeViewOrCheckedItemIsNull()
    {
        // OwnerTreeView is null
        var cut = Render(@<FluentTreeItem Id="id1" />);
        var item1 = cut.FindComponent<FluentTreeItem>().Instance;

        await item1.OnCheckChangedHandlerAsync();

        // CheckedItem is null
        cut = Render(@<FluentTreeView><FluentTreeItem Id="id1" /></FluentTreeView>);
        var item2 = cut.FindComponent<FluentTreeItem>().Instance;

        await item2.OnCheckChangedHandlerAsync();
    }

    [Theory]
    [InlineData(TreeSelectionVisibility.Collapse)]
    [InlineData(TreeSelectionVisibility.Hidden)]
    public void FluentTreeMultiple_Visibility_CollapseHidden(TreeSelectionVisibility visibility)
    {
        // Arrange && Act
        var cut = Render(@<FluentTreeView Items="@Items"
                        SelectionMode="@TreeSelectionMode.Multiple"
                        MultipleSelectionVisibility="@(e => e.Id == "id1" || e.Id == "id2" ? visibility : TreeSelectionVisibility.Visible)" />);

        // Assert
        cut.Verify(suffix: visibility.ToString());
    }
}
