    [Fact]
    public void FluentColorPickerInput_ReadOnly_NoCursorPointer()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput ReadOnly="true" Value="#FF0000" />);

        // Assert
        var swatch = cut.Find("[slot=swatch]");
        Assert.Contains("cursor: default", swatch.GetAttribute("style"));
