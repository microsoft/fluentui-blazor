@using Microsoft.FluentUI.AspNetCore.Components.ColorPicker
@using Microsoft.FluentUI.AspNetCore.Components.Tests.Extensions
@using Microsoft.FluentUI.AspNetCore.Components.Utilities
@using Xunit;
@inherits FluentUITestContext

@code
{
    public FluentColorPickerInputTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents();
    }

    [Fact]
    public void FluentColorPickerInput_Default()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput Id="colorPickerInput" />);

        // Assert
        cut.Verify();
    }

    [Fact]
    public void FluentColorPickerInput_WithValue_RendersSwatch()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput Value="#FF0000" />);

        // Assert
        var swatch = cut.Find("[slot=swatch]");
        Assert.Contains("background-color: #FF0000", swatch.GetAttribute("style"));
    }

    [Fact]
    public void FluentColorPickerInput_InvalidValue_SwatchTransparent()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput Value="not-a-color" />);

        // Assert
        var swatch = cut.Find("[slot=swatch]");
        Assert.Contains("background-color: transparent", swatch.GetAttribute("style"));
    }

    [Fact]
    public void FluentColorPickerInput_EmptyValue_SwatchTransparent()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput Value="" />);

        // Assert
        var swatch = cut.Find("[slot=swatch]");
        Assert.Contains("background-color: transparent", swatch.GetAttribute("style"));
    }

    [Fact]
    public void FluentColorPickerInput_HideTextInput_AddsHideAttribute()
    {
        // Arrange && Act
        var cut = Render(@<FluentColorPickerInput HideTextInput="true" />);

        // Assert
        var input = cut.Find("fluent-text-input");
        Assert.Equal("true", input.GetAttribute("hide-input"));
    }

