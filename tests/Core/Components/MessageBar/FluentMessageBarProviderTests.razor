    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_EmptyMessage_DoesNotRenderContent()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

