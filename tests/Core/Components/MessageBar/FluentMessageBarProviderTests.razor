@using Xunit;
@inherits FluentUITestContext

@code
{
    // A timeout can be set when you open a message bar and do not close it.
    private const int TEST_TIMEOUT = 3000;
    private const string TEST_SECTION = "test";

    public FluentMessageBarProviderTests()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddFluentUIComponents();

        NotificationService = Services.GetRequiredService<INotificationService>();
    }

    /// <summary>
    /// Gets the message bar service.
    /// </summary>
    public INotificationService NotificationService { get; }

    [Fact]
    public void FluentMessageBarProvider_RenderEmpty()
    {
        // Arrange & Act
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Assert
        Assert.DoesNotContain("<fluent-message-bar", cut.Markup);
        Assert.Contains("fluent-message-bar-provider", cut.Markup);
    }

    [Fact]
    public void FluentMessageBarProvider_GeneratesId()
    {
        // Arrange & Act
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Assert
        Assert.False(string.IsNullOrEmpty(cut.FindComponent<FluentMessageBarProvider>().Instance.Id));
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_ShowInfo_RendersMessage()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Act
        _ = NotificationService.ShowInfoBarAsync(TEST_SECTION, "Info title", "Info message");

        // Don't wait for the message bar to be closed
        await Task.CompletedTask;

        // Assert
        cut.WaitForAssertion(() =>
        {
            Assert.Contains("intent=\"info\"", cut.Markup);
            Assert.Contains("Info title", cut.Markup);
            Assert.Contains("Info message", cut.Markup);
        });
    }

