    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_Dispose_UnsubscribesAndAllowsAnotherProvider()
    {
        // Arrange
        var first = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Act: dispose by re-rendering with a different component (drops the first)
        first.FindComponent<FluentMessageBarProvider>().Instance.Dispose();

        var second = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        _ = NotificationService.ShowInfoBarAsync(TEST_SECTION, "After dispose");

        await Task.CompletedTask;

        // Assert
        second.WaitForAssertion(() => Assert.Contains("After dispose", second.Markup));
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_AllProvidersDisposed_ServiceUnavailable()
    {
        // Arrange
        var provider = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Act
        provider.FindComponent<FluentMessageBarProvider>().Instance.Dispose();

        // Assert: ProviderId is reset, ShowMessage throws
        await Assert.ThrowsAsync<FluentServiceProviderException<FluentMessageBarProvider>>(async () =>
        {
            await NotificationService.ShowInfoBarAsync(TEST_SECTION, "Nope");
        });
    }

