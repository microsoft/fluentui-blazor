    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_CloseAsync_Instance_Programmatic()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        IMessageBarInstance? captured = null;
        var task = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Title = "Instance close";
            o.OnStatusChange = args =>
            {
                if (args.Status == MessageBarLifecycleStatus.Visible)
                {
                    captured = args.Instance;
                }
            };
        });

        cut.WaitForAssertion(() => Assert.NotNull(captured));

        // Act
        await NotificationService.CloseAsync(captured!);
        var result = await task;

        // Assert
        Assert.Equal(MessageBarCloseReason.Programmatic, result.Reason);
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_CloseAsync_Instance_WithMessageBarResult()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        IMessageBarInstance? captured = null;
        var task = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Title = "With result";
            o.OnStatusChange = args =>
            {
                if (args.Status == MessageBarLifecycleStatus.Visible)
                {
                    captured = args.Instance;
                }
            };
        });

        cut.WaitForAssertion(() => Assert.NotNull(captured));

        // Act
        var customResult = MessageBarResult.OfDismissed("custom");
        await NotificationService.CloseAsync(captured!, customResult);
        var result = await task;

        // Assert
        Assert.Equal(MessageBarCloseReason.Dismissed, result.Reason);
        Assert.Equal("custom", result.Data);
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_CloseAsync_NonInstance_NoOp()
    {
        // Arrange
        Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        var fake = new FakeMessageBarInstance();

        // Act & Assert (must not throw)
        await NotificationService.CloseAsync(fake);
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_CloseAllAsync_RemovesAll()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        var task1 = NotificationService.ShowInfoBarAsync(TEST_SECTION, "One");
        var task2 = NotificationService.ShowInfoBarAsync(TEST_SECTION, "Two");

        cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll("fluent-message-bar").Count));

        // Act
        var closed = await NotificationService.CloseAllMessageBarsAsync();
        var r1 = await task1;
        var r2 = await task2;

        // Assert
        Assert.Equal(2, closed);
        Assert.Equal(MessageBarCloseReason.Programmatic, r1.Reason);
        Assert.Equal(MessageBarCloseReason.Programmatic, r2.Reason);
        cut.WaitForAssertion(() => Assert.Empty(cut.FindAll("fluent-message-bar")));
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_DoubleClose_NoOp()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        IMessageBarInstance? captured = null;
        var task = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Title = "Double";
            o.OnStatusChange = args =>
            {
                if (args.Status == MessageBarLifecycleStatus.Visible)
                {
                    captured = args.Instance;
                }
            };
        });
        cut.WaitForAssertion(() => Assert.NotNull(captured));

        // Act: close twice
        await NotificationService.CloseAsync(captured!);
        var result = await task;
        await NotificationService.CloseAsync(captured!);

        // Assert: only one result was produced
        Assert.Equal(MessageBarCloseReason.Programmatic, result.Reason);
    }

