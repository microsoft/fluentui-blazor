    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_MultipleMessages_OrderedByIndex()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Act
        _ = NotificationService.ShowInfoBarAsync(TEST_SECTION, "First");
        _ = NotificationService.ShowInfoBarAsync(TEST_SECTION, "Second");
        _ = NotificationService.ShowInfoBarAsync(TEST_SECTION, "Third");

        await Task.CompletedTask;

        // Assert
        cut.WaitForAssertion(() => Assert.Equal(3, cut.FindAll("fluent-message-bar").Count));
        var firstIndex = cut.Markup.IndexOf("First", StringComparison.Ordinal);
        var secondIndex = cut.Markup.IndexOf("Second", StringComparison.Ordinal);
        var thirdIndex = cut.Markup.IndexOf("Third", StringComparison.Ordinal);
        Assert.True(firstIndex < secondIndex && secondIndex < thirdIndex);
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_TwoProviders_DifferentSections()
    {
        // Arrange
        var cutA = Render(@<FluentMessageBarProvider Section="A" />);
        var cutB = Render(@<FluentMessageBarProvider Section="B" />);

        // Act
        _ = NotificationService.ShowInfoBarAsync("A", "OnlyA");
        _ = NotificationService.ShowInfoBarAsync("B", "OnlyB");

        await Task.CompletedTask;

        // Assert
        cutA.WaitForAssertion(() => Assert.Contains("OnlyA", cutA.Markup));
        cutB.WaitForAssertion(() => Assert.Contains("OnlyB", cutB.Markup));
        Assert.DoesNotContain("OnlyB", cutA.Markup);
        Assert.DoesNotContain("OnlyA", cutB.Markup);
    }

    /// <summary>
    /// A fake <see cref="IMessageBarInstance"/> used to verify that <see cref="NotificationService.CloseAsync(IMessageBarInstance, object?)"/>
    /// is a no-op when the instance is not a <see cref="MessageBarInstance"/>.
    /// </summary>
    private sealed class FakeMessageBarInstance : IMessageBarInstance
    {
        Type? IMessageBarInstance.ComponentType => null;
        public string Id => "fake";
        public long Index => 0;
        public MessageBarOptions Options { get; } = new() { Section = "fake" };
        public Task<MessageBarResult> Result => Task.FromResult(MessageBarResult.OfProgrammatic());
        public MessageBarLifecycleStatus LifecycleStatus => MessageBarLifecycleStatus.Visible;
        public Task CloseAsync() => Task.CompletedTask;
        public Task CloseAsync(MessageBarResult result) => Task.CompletedTask;
    }
}
