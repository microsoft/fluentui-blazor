    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_Lifetime_Zero_StaysOpen()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        // Act: a zero (or negative) lifetime should NOT schedule auto-dismiss
        var task = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Title = "NoAuto";
            o.Lifetime = TimeSpan.Zero;
        });

        // Give the scheduler a chance
        await Task.Delay(50, Xunit.TestContext.Current.CancellationToken);

        // Assert: the message is still rendered
        cut.WaitForAssertion(() => Assert.Contains("NoAuto", cut.Markup));

        // Cleanup
        await NotificationService.CloseAllMessageBarsAsync();
        await task;
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_OnStatusChange_RaisesAllEvents()
    {
        // Arrange
        var cut = Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        var statuses = new List<MessageBarLifecycleStatus>();

        var task = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Title = "Events";
            o.OnStatusChange = args => statuses.Add(args.Status);
        });

        cut.WaitForAssertion(() => Assert.Single(statuses));

        // Act
        await NotificationService.CloseAllMessageBarsAsync();
        await task;

        // Assert: Visible, Dismissed, Unmounted
        Assert.Equal(
            new[] { MessageBarLifecycleStatus.Visible, MessageBarLifecycleStatus.Dismissed, MessageBarLifecycleStatus.Unmounted },
            statuses);
    }

    [Fact(Timeout = TEST_TIMEOUT)]
    public async Task FluentMessageBarProvider_DuplicateId_Throws()
    {
        // Arrange
        Render(@<FluentMessageBarProvider Section="@TEST_SECTION" />);

        var first = NotificationService.ShowMessageBarAsync(o =>
        {
            o.Section = TEST_SECTION;
            o.Id = "dupe";
            o.Title = "First";
        });

        // Act
        var ex = await Assert.ThrowsAsync<InvalidOperationException>(async () =>
        {
            await NotificationService.ShowMessageBarAsync(o =>
            {
                o.Section = TEST_SECTION;
                o.Id = "dupe";
                o.Title = "Second";
            });
        });

        // Assert
        Assert.Contains("dupe", ex.Message);

        // Cleanup
        await NotificationService.CloseAllMessageBarsAsync();
        await first;
    }

