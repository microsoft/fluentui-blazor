@namespace Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@inherits FluentInputBase<TValue>
@typeparam TValue

@* IsFixed="false": the radios must re-render when the group changes (Value, Disabled, ...) to keep their `checked` state in sync. *@
<CascadingValue Value="this" IsFixed="false" Name="RadioGroup">
    <FluentField InputComponent="@this" ForId="@Id" Class="@ClassValue" Style="@StyleValue" IncludeInputSlot="false">
        <fluent-radio-group @ref="@Element"
                            id="@Id"
                            wrap="@Wrap"
                            disabled="@Disabled"
                            slot="@FluentSlot.FieldInput"
                            aria-labelledby="radio-group-default--label"
                            name="@GetGroupName()"
                            orientation="@Orientation.ToAttributeValue()"
                            required="@Required"
                            readonly="@ReadOnly"
                            aria-readonly="@(ReadOnly ? "true" : null)"
                            aria-label="@AriaLabel"
                            autofocus="@Autofocus"
                            tabindex="@AdditionalAttributes.GetValueIfNoAdditionalAttribute("tabindex", "-1", when: () => ReadOnly)"
                            value="@GetGroupValue()"
                            @onradiochange="@RadioChangeHandlerAsync"
                            @onfocusout="@FocusOutHandlerAsync"
                            @attributes="@AdditionalAttributes">
            @if (Items is not null)
            {
                foreach (var item in Items)
                {
                    <FluentRadio Value="@item" />
                }
            }
            @ChildContent
        </fluent-radio-group>
    </FluentField>
</CascadingValue>
