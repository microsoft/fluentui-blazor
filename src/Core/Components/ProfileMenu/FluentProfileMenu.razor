@namespace Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase

<div id="@Id"
     class="@ClassValue"
     style="@StyleValue"
     @onkeydown="@HandleKeyDownAsync"
     @onclick="@ToggleAsync"
     @attributes="@AdditionalAttributes">

    @StartTemplate

    <button id="@TriggerId"
            type="button"
            aria-expanded="@(Open ? "true" : "false")"
            aria-controls="@PopoverId"
            aria-label="@Title">
        <FluentAvatar Image="@ImageUrl"
                      Initials="@ImageInitials"
                      Name="@Title"
                      Size="@(ImageSize ?? AvatarSize.Size32)">
            @if (Status is not null)
            {
                <FluentPresenceBadge Status="@Status"
                                     Size="@(StatusSize ?? BadgeSize.ExtraSmall)"
                                     title="@GetStatusTitle()"
                                     slot="@FluentSlot.Badge" />
            }
        </FluentAvatar>
    </button>

    @EndTemplate
</div>

<FluentPopover Id="@PopoverId"
               AnchorId="@TriggerId"
               Opened="@Open"
               OpenedChanged="@HandleOpenChangedAsync">
    @ChildContent
</FluentPopover>
