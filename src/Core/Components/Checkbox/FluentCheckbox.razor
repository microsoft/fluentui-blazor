@namespace Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@inherits FluentInputBase<bool>

<FluentField InputComponent="@this"
             ForId="@Id"
             Class="@ClassValue"
             Style="@StyleValue"
             LabelTemplate="@LabelTemplate.CombinedWith(ChildContent)"
             Size="@Size.ToFieldSize()">
    <fluent-checkbox @ref="@Element"
                     aria-label="@AriaLabel"
                     autofocus="@Autofocus"
                     checked="@(_checked ? "true" : null)"
                     disabled="@Disabled"
                     indeterminate="@(_indeterminate ? "true" : null)"
                     id="@Id"
                     name="@Name"
                     readonly="@ReadOnly"
                     required="@Required"
                     shape="@Shape.ToAttributeValue()"
                     size="@Size.ToAttributeValue()"
                     @onfocusout="@FocusOutHandlerAsync"
                     @attributes="@AdditionalAttributes"
                     @onchange="@OnCheckChangedHandlerAsync"
                     value = "@bool.TrueString.ToLower()"
                     slot="@FluentSlot.FieldInput" />
</FluentField>
