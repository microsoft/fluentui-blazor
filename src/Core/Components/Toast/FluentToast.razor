@namespace Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using System.Globalization

<fluent-toast-b id="@Id"
                class="@ClassValue"
                style="@StyleValue"
                opened="@(Opened ? "true" : "false")"
                timeout="@(Lifetime?.TotalMilliseconds.ToString(CultureInfo.InvariantCulture))"
                position="@Position.ToAttributeValue()"
                inverted="@(Inverted ? "true" : null)"
                intent="@Intent.ToAttributeValue()"
                politeness="@Politeness.ToAttributeValue()"
                pause-on-hover="@(PauseOnHover ? "true" : null)"
                pause-on-window-blur="@(PauseOnWindowBlur ? "true" : null)"
                vertical-offset="@VerticalOffset"
                horizontal-offset="@HorizontalOffset"
                role="listitem"
                aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : $"{Id}-title")"
                aria-describedby="@(ChildContent is null ? null : $"{Id}-body")"
                @attributes="@AdditionalAttributes"
                @ondialogtoggle="@OnToggleAsync"
                @ondialogbeforetoggle="@OnToggleAsync">

    @* Slot Media: spinner or icon *@
    @if (Intent is not null || Icon is not null)
    {
        <div slot="@FluentSlot.ToastMedia" aria-hidden="true">
            @if (Intent == ToastIntent.Progress)
            {
                <FluentSpinner Visible="true" Size="@SpinnerSize.Tiny" Style="--size: 1em;" />
            }
            else if (Icon is not null)
            {
                <FluentIcon Value="@Icon" Width="1em" />
            }
            else
            {
                <FluentIcon Value="@GetIntentIcon()" Width="1em" />
            }
        </div>
    }

    @* Slot Title *@
    @if (!string.IsNullOrEmpty(Title))
    {
        <div id="@($"{Id}-title")" slot="@FluentSlot.ToastTitle">
             @(new MarkupStringSanitized(Title, MarkupStringSanitized.Formats.Html, LibraryConfiguration))
        </div>
    }

    @* Slot Action (right of title)*@
    @if (AllowDismiss)
    {
        @if (string.IsNullOrEmpty(DismissLabel))
        {
            <FluentButton slot="@FluentSlot.ToastAction"
                          Appearance="@ButtonAppearance.Subtle"
                          IconStart="@(new CoreIcons.Regular.Size20.Dismiss().WithColor("currentColor"))"
                          IconOnly="true"
                          Size="ButtonSize.Small"
                          OnClick="@DismissClickAsync"
                          Tooltip="@DismissTooltip" />
        }
        else
        {
            <FluentLink slot="@FluentSlot.ToastAction"
                        OnClick="@DismissClickAsync"
                        Tooltip="@DismissTooltip"
                        Style="@(Inverted ? "color: var(--colorBrandForegroundInverted);" : null)">
                @DismissLabel
            </FluentLink>
        }
    }

    @if (ChildContent is not null)
    {
        <div id="@($"{Id}-body")">
            @ChildContent
        </div>
    }

    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div slot="@FluentSlot.ToastSubtitle">
            @(new MarkupStringSanitized(Subtitle, MarkupStringSanitized.Formats.Html, LibraryConfiguration))
        </div>
    }

    @if (FooterTemplate is not null)
    {
        <div slot="@FluentSlot.ToastFooter">
            @FooterTemplate
        </div>
    }
</fluent-toast-b>
