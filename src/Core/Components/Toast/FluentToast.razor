@namespace Microsoft.FluentUI.AspNetCore.Components
@inherits FluentComponentBase
@using Microsoft.FluentUI.AspNetCore.Components.Extensions

<fluent-toast-b id="@Id"
                class="@ClassValue"
                style="@StyleValue"
                opened="@(Opened ? "true" : "false")"
                timeout="@Lifetime"
                position="@Position.ToAttributeValue()"
                inverted="@(Inverted ? "true" : null)"
                intent="@Intent.ToAttributeValue()"
                politeness="@Politeness.ToAttributeValue()"
                pause-on-hover="@(PauseOnHover ? "true" : null)"
                pause-on-window-blur="@(PauseOnWindowBlur ? "true" : null)"
                vertical-offset="@VerticalOffset"
                horizontal-offset="@HorizontalOffset"
                role="listitem"
                aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : $"{Id}-title")"
                aria-describedby="@(ChildContent is null ? null : $"{Id}-body")"
                @attributes="@AdditionalAttributes"
                @ondialogtoggle="@OnToggleAsync"
                @ondialogbeforetoggle="@OnToggleAsync">

    @* Slot Media: spinner or icon *@
    @* @if (Type == ToastType.IndeterminateProgress)
    {
        <div slot="media">
            <FluentSpinner Visible="true"
                           Size="@SpinnerSize.Tiny"
                           Style="--size: 1em;" />
        </div>
    }
    else *@
    {
        <div slot="media"
             aria-hidden="true">
            <FluentIcon Value="@GetTitleIcon()" Width="1em" />
        </div>
    }

    @* Slot Title *@
    @if (!string.IsNullOrEmpty(Title))
    {
        <div id="@($"{Id}-title")" slot="title">@Title</div>
    }

    @* Slot Action *@
    @if (AllowDismiss)
    {
        @if (!string.IsNullOrEmpty(DismissAction))
        {
            <FluentLink slot="action"
                        OnClick="@DismissClickAsync"
                        Style="@(Inverted ? "color: var(--colorBrandForegroundInverted);" : null)">
                @DismissAction
            </FluentLink>
        }
        else
        {
            <FluentButton Appearance="@ButtonAppearance.Subtle"
                          IconOnly="true"
                          IconStart="@DismissIcon"
                          slot="action"
                          OnClick="@DismissClickAsync" />
        }
    }

    @if (ChildContent is not null)
    {
        <div id="@($"{Id}-body")">@ChildContent</div>
    }
@* 
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div slot="subtitle">@Subtitle</div>
    }

    @if (!string.IsNullOrEmpty(QuickAction1) || !string.IsNullOrEmpty(QuickAction2))
    {
        <div slot="footer">
            @if (!string.IsNullOrEmpty(QuickAction1))
            {
                <FluentLink OnClick="@OnQuickAction1ClickedAsync"
                            Style="@(Inverted ? "color: var(--colorBrandForegroundInverted);" : null)">
                    @QuickAction1
                </FluentLink>
            }

            @if (!string.IsNullOrEmpty(QuickAction2))
            {
                <FluentLink OnClick="@OnQuickAction2ClickedAsync"
                            Style="@(Inverted ? "color: var(--colorBrandForegroundInverted);" : null)">
                    @QuickAction2
                </FluentLink>
            }
        </div>
    } *@
</fluent-toast-b>
