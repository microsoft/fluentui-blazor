@namespace Microsoft.FluentUI.AspNetCore.Components.Dialog.SplashScreen

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 VerticalGap="16px"
                 Padding="@Padding.All6">
        <FluentSpinner />
        <FluentText>@SplashScreen.SplashScreen.Message</FluentText>
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public required SplashScreenOptions SplashScreen { get; set; }
}
